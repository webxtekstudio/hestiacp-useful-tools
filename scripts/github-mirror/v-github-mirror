sanitize_repo_url() {
    printf '%s' "$1" | sed -E 's#(https?://)[^/@]+@#\1***@#'
}

log_git_output() {
    local out="$1"
    [ -z "$out" ] && return 0
    printf '%s\n' "$out" | sed -E 's#(https?://)[^/@]+@#\1***@#' >> "$LOG_FILE"
}

REMOTE_REF=""
REMOTE_HEAD=""
LAST_GIT_ERR=""

_load_readonly_token() {
    [ -f "$TOKEN_FILE" ] || return 1
    [ -L "$TOKEN_FILE" ] && return 1
    local meta owner perm tok
    meta=$(stat -c '%u:%a' "$TOKEN_FILE" 2>/dev/null) || return 1
    owner="${meta%%:*}"
    perm="${meta##*:}"
    [ "$owner" = "0" ] || return 1
    case "$perm" in
        400|600) ;;
        *) return 1 ;;
    esac
    tok=$(head -n 1 "$TOKEN_FILE" 2>/dev/null | tr -d '[:space:]')
    [ -n "$tok" ] || return 1
    printf '%s' "$tok"
}

# Execute network git ONLY as isolated root (never as tenant user, never reading tenant files).
# Supports either /root/.ssh deploy/user key or optional /etc/hestiacp-github-mirror.token (0600 root:root).
_run_root_git_net() {
    local repo_url="$1"
    shift
    local tok auth_hdr https_url
    if tok=$(_load_readonly_token); then
        auth_hdr="Authorization: Basic $(printf 'x-access-token:%s' "$tok" | base64 -w0)"
        https_url="$repo_url"
        if [[ "$https_url" =~ ^git@github\.com:(.+)$ ]]; then
            https_url="https://github.com/${BASH_REMATCH[1]}"
        fi
        GIT_TERMINAL_PROMPT=0 \
        GIT_CONFIG_NOSYSTEM=1 \
        GIT_CONFIG_COUNT=1 \
        GIT_CONFIG_KEY_0="http.https://github.com/.extraheader" \
        GIT_CONFIG_VALUE_0="$auth_hdr" \
        git "$@" "$https_url" 9>&-
        return $?
    fi

    GIT_TERMINAL_PROMPT=0 \
    GIT_SSH_COMMAND="$GIT_NET_SSH" \
    git "$@" "$repo_url" 9>&-
}

# Execute offline local git as target HestiaCP user with sanitized env, closed lock FD,
# and zero access to ~/.gitconfig, /etc/gitconfig, hooks, fsmonitor, or network.
_run_user_git() {
    local user="$1"
    shift
    runuser -u "$user" -- env -i \
        PATH="/usr/local/bin:/usr/bin:/bin" \
        HOME="/nonexistent" \
        GIT_CONFIG_NOSYSTEM=1 \
        GIT_CONFIG_GLOBAL=/dev/null \
        GIT_TERMINAL_PROMPT=0 \
        GIT_SSH_COMMAND=/bin/false \
        git -c core.hooksPath=/dev/null -c core.fsmonitor=false -c protocol.allow=never "$@" 9>&-
}

_run_user_local_fetch_or_clone() {
    local user="$1"
    shift
    runuser -u "$user" -- env -i \
        PATH="/usr/local/bin:/usr/bin:/bin" \
        HOME="/nonexistent" \
        GIT_CONFIG_NOSYSTEM=1 \
        GIT_CONFIG_GLOBAL=/dev/null \
        GIT_TERMINAL_PROMPT=0 \
        GIT_SSH_COMMAND=/bin/false \
        git -c core.hooksPath=/dev/null -c core.fsmonitor=false -c protocol.allow=never -c protocol.file.allow=always "$@" 9>&-
}

_parse_ls_remote_output() {
    local out="$1"
    local branch="$2"
    local head_sha peeled_tag_sha raw_tag_sha
    head_sha=$(printf '%s\n' "$out" | awk -v r="refs/heads/$branch" '$2 == r {print $1; exit}')
    if [ -n "$head_sha" ]; then
        REMOTE_REF="refs/heads/$branch"
        REMOTE_HEAD="$head_sha"
        return 0
    fi
    peeled_tag_sha=$(printf '%s\n' "$out" | awk -v r="refs/tags/$branch^{}" '$2 == r {print $1; exit}')
    raw_tag_sha=$(printf '%s\n' "$out" | awk -v r="refs/tags/$branch" '$2 == r {print $1; exit}')
    if [ -n "$raw_tag_sha" ]; then
        REMOTE_REF="refs/tags/$branch"
        REMOTE_HEAD="${peeled_tag_sha:-$raw_tag_sha}"
        return 0
    fi
    return 1
}

resolve_remote_ref() {
    local repo="$1"
    local branch="$2"
    local out rc tok auth_hdr effective_repo

    REMOTE_REF=""
    REMOTE_HEAD=""
    LAST_GIT_ERR=""

    effective_repo="$repo"
    if tok=$(_load_readonly_token); then
        auth_hdr="Authorization: Basic $(printf 'x-access-token:%s' "$tok" | base64 -w0)"
        if [[ "$effective_repo" =~ ^git@github\.com:(.+)$ ]]; then
            effective_repo="https://github.com/${BASH_REMATCH[1]}"
        fi
        out=$(GIT_TERMINAL_PROMPT=0 GIT_CONFIG_NOSYSTEM=1 GIT_CONFIG_COUNT=1 GIT_CONFIG_KEY_0="http.https://github.com/.extraheader" GIT_CONFIG_VALUE_0="$auth_hdr" git ls-remote "$effective_repo" "refs/heads/$branch" "refs/tags/$branch^{}" "refs/tags/$branch" 9>&- 2>&1)
        rc=$?
    else
        out=$(GIT_TERMINAL_PROMPT=0 GIT_SSH_COMMAND="$GIT_NET_SSH" git ls-remote "$repo" "refs/heads/$branch" "refs/tags/$branch^{}" "refs/tags/$branch" 9>&- 2>&1)
        rc=$?
    fi

    if [ "$rc" -eq 0 ]; then
        if _parse_ls_remote_output "$out" "$branch"; then
            return 0
        fi
        LAST_GIT_ERR="Remote branch or tag '$branch' not found"
        return 1
    fi

    LAST_GIT_ERR="$out"
    return 1
}

# Descriptor-pinned O_NOFOLLOW sanitizer for tenant mirror repositories:
# - Replaces .git/config atomically with a minimal offline config (zero remote URLs,
#   zero fsmonitor/sshCommand/filter/hooks directives) BEFORE and AFTER local git runs.
# - Locks the mirror directory permissions to 0700 (owner-only, compatible with HestiaCP
#   v-backup-user and v-restore-user while completely inert/offline).
_sanitize_user_git_repo() {
    local user_home="$1"
    local dest_rel="$2"
    local user="$3"
    local branch="$4"
    local target_uid target_gid
    target_uid=$(id -u "$user" 2>/dev/null) || return 1
    target_gid=$(id -g "$user" 2>/dev/null) || return 1

    python3 - "$user_home" "$dest_rel" "$target_uid" "$target_gid" "$branch" << 'PYEOF' 9>&- 2>/dev/null
import os
import re
import stat
import sys

user_home, dest_rel, uid_s, gid_s, branch = sys.argv[1:6]
uid, gid = int(uid_s), int(gid_s)

if not re.match(r"^[A-Za-z0-9._/-]+$", branch) or ".." in branch:
    branch = "main"

parts = [p for p in dest_rel.split("/") if p]
if not parts or any(p in (".", "..") for p in parts):
    sys.exit(1)

cur_fd = os.open(user_home, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
try:
    for part in parts:
        nxt_fd = os.open(part, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW, dir_fd=cur_fd)
        os.close(cur_fd)
        cur_fd = nxt_fd

    st_root = os.fstat(cur_fd)
    if not stat.S_ISDIR(st_root.st_mode):
        sys.exit(1)
    os.fchmod(cur_fd, 0o700)

    git_fd = os.open(".git", os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW, dir_fd=cur_fd)
    try:
        os.fchmod(git_fd, 0o700)
        clean_cfg = (
            "[core]\n"
            "\trepositoryformatversion = 0\n"
            "\tfilemode = true\n"
            "\tbare = false\n"
            "\tlogallrefupdates = true\n"
            f'[branch "{branch}"]\n'
            f"\tmerge = refs/heads/{branch}\n"
        ).encode("utf-8")

        tmp_name = f".config.clean.{os.getpid()}"
        try:
            os.unlink(tmp_name, dir_fd=git_fd)
        except FileNotFoundError:
            pass

        tfd = os.open(
            tmp_name,
            os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW,
            0o600,
            dir_fd=git_fd,
        )
        try:
            os.write(tfd, clean_cfg)
            os.fchown(tfd, uid, gid)
            os.fchmod(tfd, 0o600)
        finally:
            os.close(tfd)

        os.replace(tmp_name, "config", src_dir_fd=git_fd, dst_dir_fd=git_fd)

        # Remove .git/info/attributes if present so no custom smudge/clean filter attributes apply
        try:
            info_fd = os.open("info", os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW, dir_fd=git_fd)
            try:
                os.unlink("attributes", dir_fd=info_fd)
            except FileNotFoundError:
                pass
            finally:
                os.close(info_fd)
        except FileNotFoundError:
            pass
    finally:
        os.close(git_fd)
finally:
    os.close(cur_fd)
PYEOF
}

# Descriptor-pinned O_NOFOLLOW legacy repair for repos previously cloned as root (UID 0).
# Rejects any intermediate symlink and never touches HestiaCP root-protected domain dirs.
_repair_legacy_root_repo_ownership() {
    local user_home="$1"
    local dest_rel="$2"
    local user="$3"
    local target_uid target_gid
    target_uid=$(id -u "$user" 2>/dev/null) || return 1
    target_gid=$(id -g "$user" 2>/dev/null) || return 1

    python3 - "$user_home" "$dest_rel" "$target_uid" "$target_gid" << 'PYEOF' 9>&- 2>/dev/null
import os
import stat
import sys

user_home, dest_rel, uid_s, gid_s = sys.argv[1], sys.argv[2], sys.argv[3], sys.argv[4]
uid, gid = int(uid_s), int(gid_s)
SKIP_TOP = {"logs", "stats", "document_errors"}

parts = [p for p in dest_rel.split("/") if p]
if not parts or any(p in (".", "..") for p in parts):
    sys.exit(1)

cur_fd = os.open(user_home, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
try:
    for part in parts:
        nxt_fd = os.open(part, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW, dir_fd=cur_fd)
        os.close(cur_fd)
        cur_fd = nxt_fd

    git_st = os.stat(".git", dir_fd=cur_fd, follow_symlinks=False)
    if not stat.S_ISDIR(git_st.st_mode) or git_st.st_uid != 0:
        sys.exit(0)

    if os.fstat(cur_fd).st_uid == 0:
        os.fchown(cur_fd, uid, gid)

    def walk_fd(dfd, top=False):
        with os.scandir(dfd) as it:
            for entry in it:
                if top and entry.name in SKIP_TOP:
                    continue
                try:
                    est = entry.stat(follow_symlinks=False)
                except OSError:
                    continue
                if stat.S_ISLNK(est.st_mode):
                    if est.st_uid == 0:
                        try:
                            os.chown(entry.name, uid, gid, dir_fd=dfd, follow_symlinks=False)
                        except OSError:
                            pass
                elif stat.S_ISDIR(est.st_mode):
                    try:
                        cfd = os.open(entry.name, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW, dir_fd=dfd)
                    except OSError:
                        continue
                    try:
                        if os.fstat(cfd).st_uid == 0:
                            os.fchown(cfd, uid, gid)
                        walk_fd(cfd, False)
                    finally:
                        os.close(cfd)
                elif stat.S_ISREG(est.st_mode):
                    try:
                        ffd = os.open(entry.name, os.O_RDONLY | os.O_NOFOLLOW, dir_fd=dfd)
                    except OSError:
                        continue
                    try:
                        if os.fstat(ffd).st_uid == 0:
                            os.fchown(ffd, uid, gid)
                    finally:
                        os.close(ffd)

    walk_fd(cur_fd, True)
finally:
    os.close(cur_fd)
PYEOF
}

sync_overwrite_existing() {
    local user="$1"
    local user_group="$2"
    local user_home="$3"
    local repo="$4"
    local branch="$5"
    local dest="$6"
    local dest_rel="$7"
    local local_head stage_git out rc tok auth_hdr effective_repo

    if [ "$(stat -c '%u' "$dest/.git" 2>/dev/null)" = "0" ]; then
        _repair_legacy_root_repo_ownership "$user_home" "$dest_rel" "$user" || true
    fi

    # Always overwrite .git/config with a clean static config BEFORE running git in tenant dir
    _sanitize_user_git_repo "$user_home" "$dest_rel" "$user" "$branch" || return 1

    if ! resolve_remote_ref "$repo" "$branch"; then
        log_git_output "$LAST_GIT_ERR"
        return 1
    fi

    local_head=$(_run_user_git "$user" -C "$dest" rev-parse --verify HEAD 2>/dev/null || true)
    if [ -n "$REMOTE_HEAD" ] && [ "$REMOTE_HEAD" = "$local_head" ]; then
        out=$(_run_user_git "$user" -C "$dest" reset --hard HEAD 2>&1) || { log_git_output "$out"; return 1; }
        log_git_output "$out"
        _sanitize_user_git_repo "$user_home" "$dest_rel" "$user" "$branch" || return 1
        return 0
    fi

    # Stage fetch into an isolated bare repo without objects/info/alternates so root git
    # never reads or follows tenant-controlled object stores, and tenant never touches credentials.
    install -d -m 0711 -o root -g root "$STAGE_BASE" || return 1
    stage_git=$(mktemp -d "$STAGE_BASE/stage.$$.XXXXXX") || return 1
    git init --bare -q "$stage_git"

    effective_repo="$repo"
    if tok=$(_load_readonly_token); then
        auth_hdr="Authorization: Basic $(printf 'x-access-token:%s' "$tok" | base64 -w0)"
        if [[ "$effective_repo" =~ ^git@github\.com:(.+)$ ]]; then
            effective_repo="https://github.com/${BASH_REMATCH[1]}"
        fi
        out=$(GIT_TERMINAL_PROMPT=0 GIT_CONFIG_NOSYSTEM=1 GIT_CONFIG_COUNT=1 GIT_CONFIG_KEY_0="http.https://github.com/.extraheader" GIT_CONFIG_VALUE_0="$auth_hdr" git --git-dir="$stage_git" -c core.hooksPath=/dev/null fetch --no-tags "$effective_repo" "+${REMOTE_REF}:refs/mirror/target" 9>&- 2>&1)
        rc=$?
    else
        out=$(GIT_TERMINAL_PROMPT=0 GIT_SSH_COMMAND="$GIT_NET_SSH" git --git-dir="$stage_git" -c core.hooksPath=/dev/null fetch --no-tags "$repo" "+${REMOTE_REF}:refs/mirror/target" 9>&- 2>&1)
        rc=$?
    fi
    log_git_output "$out"
    if [ "$rc" -ne 0 ]; then
        rm -rf "$stage_git"
        return 1
    fi

    chown -RP "$user:$user_group" "$stage_git"
    chmod -R u=rwX,go= "$stage_git"
    out=$(_run_user_local_fetch_or_clone "$user" -C "$dest" fetch --no-tags "$stage_git" "+refs/mirror/target:refs/remotes/origin/$branch" 2>&1)
    rc=$?
    log_git_output "$out"
    rm -rf "$stage_git"
    [ "$rc" -eq 0 ] || return 1

    out=$(_run_user_git "$user" -C "$dest" reset --hard "refs/remotes/origin/$branch" 2>&1) || { log_git_output "$out"; return 1; }
    log_git_output "$out"
    _sanitize_user_git_repo "$user_home" "$dest_rel" "$user" "$branch" || return 1
    return 0
}

clone_repo_staged() {
    local user="$1"
    local user_group="$2"
    local user_home="$3"
    local repo="$4"
    local branch="$5"
    local target_dir="$6"
    local dest_rel="$7"
    local shallow_mode="$8"
    local depth_args=()
    local stage_git out rc tok auth_hdr effective_repo

    [ "$shallow_mode" = "shallow" ] && depth_args=(--depth 1)

    install -d -m 0711 -o root -g root "$STAGE_BASE" || return 1
    stage_git=$(mktemp -d "$STAGE_BASE/stage.$$.XXXXXX") || return 1

    effective_repo="$repo"
    if tok=$(_load_readonly_token); then
        auth_hdr="Authorization: Basic $(printf 'x-access-token:%s' "$tok" | base64 -w0)"
        if [[ "$effective_repo" =~ ^git@github\.com:(.+)$ ]]; then
            effective_repo="https://github.com/${BASH_REMATCH[1]}"
        fi
        out=$(GIT_TERMINAL_PROMPT=0 GIT_CONFIG_NOSYSTEM=1 GIT_CONFIG_COUNT=1 GIT_CONFIG_KEY_0="http.https://github.com/.extraheader" GIT_CONFIG_VALUE_0="$auth_hdr" git -c core.hooksPath=/dev/null clone --bare -b "$branch" "${depth_args[@]}" "$effective_repo" "$stage_git" 9>&- 2>&1)
        rc=$?
    else
        out=$(GIT_TERMINAL_PROMPT=0 GIT_SSH_COMMAND="$GIT_NET_SSH" git -c core.hooksPath=/dev/null clone --bare -b "$branch" "${depth_args[@]}" "$repo" "$stage_git" 9>&- 2>&1)
        rc=$?
    fi

    if [ "$rc" -ne 0 ]; then
        rm -rf "$stage_git"
        log_git_output "$out"
        return 1
    fi

    log_git_output "$out"
    chown -RP "$user:$user_group" "$stage_git"
    chmod -R u=rwX,go= "$stage_git"
    out=$(_run_user_local_fetch_or_clone "$user" clone --no-local -b "$branch" "$stage_git" "$target_dir" 2>&1)
    rc=$?
    log_git_output "$out"
    rm -rf "$stage_git"
    [ "$rc" -eq 0 ] || return 1

    if [ -n "$dest_rel" ]; then
        _sanitize_user_git_repo "$user_home" "$dest_rel" "$user" "$branch" || return 1
    fi
    return 0
}

# Argument parsing
# Check for test mode
if [ "$1" == "--test-email" ]; then
    log "Running in TEST EMAIL mode..."
    REPOS_SUCCESS+=("TestUser/TestRepo1: Updated successfully")
    REPOS_FAILED+=("TestUser/TestRepo2: Authentication failed")
    send_html_email "FAILED" "$ADMIN_EMAIL"
    echo "Test email sent to $ADMIN_EMAIL"
    exit 0
fi

if [ "$1" == "--force-notification" ]; then
    log "Running in FORCE NOTIFICATION mode..."
    NOTIFY_ON_SUCCESS="true"

fi

if [ ! -f "$CONFIG_FILE" ]; then
    msg="ERROR: Config file $CONFIG_FILE not found."
    log "$msg"
    REPOS_FAILED+=("Config: $msg")
    send_html_email "FAILED" "$ADMIN_EMAIL"
    FATAL_HANDLED="true"
    exit 1
fi

[[ "$DAILY_BACKUPS_COUNT" =~ ^[0-9]+$ ]] || DAILY_BACKUPS_COUNT=7
[[ "$WEEKLY_BACKUPS_COUNT" =~ ^[0-9]+$ ]] || WEEKLY_BACKUPS_COUNT=4
[[ "$MONTHLY_BACKUPS_COUNT" =~ ^[0-9]+$ ]] || MONTHLY_BACKUPS_COUNT=3

log "Starting GitHub Mirror process..."

# Read config file line by line
# Format: USER|REPO_URL|BRANCH|DESTINATION_PATH|RETENTION_MODE|RETENTION_COUNT
while IFS='|' read -r user repo branch dest_path retention_mode retention_count || [ -n "$user" ]; do
    # Strip whitespace/CR first so CRLF or indented comment lines are skipped cleanly
    user=$(printf '%s' "$user" | tr -d '[:space:]')
    [[ -z "$user" ]] && continue
    [[ "$user" =~ ^# ]] && continue

    repo=$(printf '%s' "$repo" | tr -d '[:space:]')
    branch=$(printf '%s' "$branch" | tr -d '[:space:]')
    dest_path=$(printf '%s' "$dest_path" | tr -d '[:space:]')
    retention_mode=$(printf '%s' "$retention_mode" | tr -d '[:space:]')
    retention_count=$(printf '%s' "$retention_count" | tr -d '[:space:]')

    # Default values & strict integer validation
    retention_mode=${retention_mode:-"overwrite"}
    [[ "$retention_count" =~ ^[1-9][0-9]*$ ]] || retention_count=1
    safe_repo=$(sanitize_repo_url "$repo")

    # Validate User
    if ! id "$user" >/dev/null 2>&1; then
        msg="User $user does not exist. Skipping $safe_repo."
        log "WARNING: $msg"
        REPOS_FAILED+=("$user/$safe_repo: $msg")
        continue
    fi

    # Reject empty or path-traversal destinations
    case "$dest_path" in
        ""|*..*|/*)
            msg="Invalid destination path '$dest_path'. Must be relative to user home without '..'."
            log "ERROR: $msg"
            REPOS_FAILED+=("$user/$safe_repo: $msg")
            continue
            ;;
    esac

    USER_HOME=$(getent passwd "$user" | cut -d: -f6)
    [ -z "$USER_HOME" ] && USER_HOME="/home/$user"
    user_group=$(id -gn "$user" 2>/dev/null || echo "$user")
    BASE_DEST_PATH="${USER_HOME%/}/$dest_path"
    
    # Ensure destination parent directory exists as target user
    if [ ! -d "$(dirname "$BASE_DEST_PATH")" ]; then
        log "Creating parent directory for $user: $(dirname "$BASE_DEST_PATH")"
        mkdir_err=$(runuser -u "$user" -- env -i PATH="/usr/bin:/bin" mkdir -p "$(dirname "$BASE_DEST_PATH")" 9>&- 2>&1)
        if [ $? -ne 0 ]; then
            log_git_output "$mkdir_err"
            msg="Failed to create parent directory $(dirname "$BASE_DEST_PATH")"
            log "ERROR: $msg"
            REPOS_FAILED+=("$user/$safe_repo: $msg")
            continue
        fi
    fi

    log "Processing $safe_repo for user $user (Mode: $retention_mode)..."

    error_msg=""

    if [ "$retention_mode" == "overwrite" ]; then
        # === OVERWRITE MODE ===
        if [ -d "$BASE_DEST_PATH/.git" ]; then
            if sync_overwrite_existing "$user" "$user_group" "$USER_HOME" "$repo" "$branch" "$BASE_DEST_PATH" "$dest_path"; then
                log "SUCCESS: Updated $safe_repo."
                last_commit=$(_run_user_git "$user" -C "$BASE_DEST_PATH" log -1 --no-show-signature --date=format:"%Y-%m-%d %H:%M" --format="%cd" 2>/dev/null)
                short_hash=$(_run_user_git "$user" -C "$BASE_DEST_PATH" log -1 --no-show-signature --format="%h" 2>/dev/null)
                REPOS_SUCCESS+=("$user/$safe_repo (Updated: $last_commit - $short_hash)")
            else
                error_msg="Failed to update $safe_repo"
                log "ERROR: $error_msg"
                REPOS_FAILED+=("$user/$safe_repo: $error_msg")
            fi
        else
            log "Cloning $safe_repo into $BASE_DEST_PATH..."
            if clone_repo_staged "$user" "$user_group" "$USER_HOME" "$repo" "$branch" "$BASE_DEST_PATH" "$dest_path" "full"; then
                log "SUCCESS: Cloned $safe_repo."
                last_commit=$(_run_user_git "$user" -C "$BASE_DEST_PATH" log -1 --no-show-signature --date=format:"%Y-%m-%d %H:%M" --format="%cd" 2>/dev/null)
                short_hash=$(_run_user_git "$user" -C "$BASE_DEST_PATH" log -1 --no-show-signature --format="%h" 2>/dev/null)
                REPOS_SUCCESS+=("$user/$safe_repo (Cloned: $last_commit - $short_hash)")
            else
                error_msg="Failed to clone $safe_repo"
                log "ERROR: $error_msg"
                REPOS_FAILED+=("$user/$safe_repo: $error_msg")
            fi
        fi

    elif [ "$retention_mode" == "versioned" ] || [ "$retention_mode" == "backup" ]; then
        # === BACKUP / VERSIONED MODE ===
        TIMESTAMP=$(date '+%Y%m%d_%H%M%S')
        VERSION_DIR="${BASE_DEST_PATH}_${TIMESTAMP}"
        VERSION_REL="${dest_path}_${TIMESTAMP}"
        
        log "Cloning new version into $VERSION_DIR..."
        if clone_repo_staged "$user" "$user_group" "$USER_HOME" "$repo" "$branch" "$VERSION_DIR" "$VERSION_REL" "shallow"; then
            log "SUCCESS: Cloned version $TIMESTAMP."
            runuser -u "$user" -- env -i PATH="/usr/bin:/bin" rm -rf "$VERSION_DIR/.git" 9>&-
            REPOS_SUCCESS+=("$user/$safe_repo (Backup)")
            
            # Match ONLY exact <basename>_YYYYMMDD_HHMMSS directories (never unrelated prefix siblings)
            dest_parent=$(dirname "${BASE_DEST_PATH}_x")
            dest_base=$(basename "$BASE_DEST_PATH")
            BACKUPS=()
            while IFS= read -r -d '' candidate_dir; do
                candidate_base=$(basename "$candidate_dir")
                if [[ "$candidate_base" == "${dest_base}_"* ]]; then
                    suffix="${candidate_base#"${dest_base}_"}"
                    if [[ "$suffix" =~ ^[0-9]{8}_[0-9]{6}$ ]]; then
                        BACKUPS+=("$candidate_dir")
                    fi
                fi
            done < <(find "$dest_parent" -mindepth 1 -maxdepth 1 -type d -name "${dest_base}_*" -print0 2>/dev/null | sort -z)

            # --- Retention Cleanup Logic ---
            if [ "$retention_mode" == "backup" ]; then
                # SMART RETENTION (Daily/Weekly/Monthly)
                log "Running smart retention cleanup..."
                
                CURRENT_DATE_SEC=$(date +%s)
                
                # Always keep the newly created backup snapshot
                declare -A KEEP_LIST=()
                KEEP_LIST["$VERSION_DIR"]=1
                
                for backup in "${BACKUPS[@]}"; do
                    dirname=$(basename "$backup")
                    suffix="${dirname#"${dest_base}_"}"
                    date_str="${suffix%%_*}"
                    
                    if [ -z "$date_str" ]; then continue; fi
                    
                    # Calculate age in days
                    backup_date_sec=$(date -d "$date_str" +%s 2>/dev/null)
                    if [ -z "$backup_date_sec" ]; then continue; fi
                    
                    age_days=$(( (CURRENT_DATE_SEC - backup_date_sec) / 86400 ))
                    day_of_week=$(date -d "$date_str" +%u) # 1=Monday, 7=Sunday
                    day_of_month=$(date -d "$date_str" +%-d) # 1-31 (no leading zero)
                    
                    # DAILY RETENTION
                    if [ "$ENABLE_DAILY_BACKUPS" == "true" ] && [ "$age_days" -lt "$DAILY_BACKUPS_COUNT" ]; then
                        KEEP_LIST["$backup"]=1
                        log "Keeping DAILY backup: $dirname (Age: $age_days days)"
                    fi
                    
                    # WEEKLY RETENTION (Keep Sunday backups)
                    if [ "$ENABLE_WEEKLY_BACKUPS" == "true" ] && [ "$day_of_week" -eq 7 ] && [ "$age_days" -lt $((WEEKLY_BACKUPS_COUNT * 7)) ]; then
                         KEEP_LIST["$backup"]=1
                         log "Keeping WEEKLY backup: $dirname (Sunday)"
                    fi
                    
                    # MONTHLY RETENTION (Keep 1st of month backups)
                    if [ "$ENABLE_MONTHLY_BACKUPS" == "true" ] && [ "$day_of_month" -eq 1 ] && [ "$age_days" -lt $((MONTHLY_BACKUPS_COUNT * 30)) ]; then
                         KEEP_LIST["$backup"]=1
                         log "Keeping MONTHLY backup: $dirname (1st of Month)"
                    fi
                done
                
                # Cleanup phase
                for backup in "${BACKUPS[@]}"; do
                    if [ -z "${KEEP_LIST["$backup"]}" ]; then
                        log "Deleting old backup: $(basename "$backup")"
                        runuser -u "$user" -- env -i PATH="/usr/bin:/bin" rm -rf "$backup" 9>&-
                    fi
                done
                unset KEEP_LIST
                
            else
                # SIMPLE RETENTION (Keep last N exact timestamped directories)
                log "Cleaning up old versions (keeping last $retention_count)..."
                total_versions=${#BACKUPS[@]}
                if [ "$total_versions" -gt "$retention_count" ]; then
                    prune_until=$((total_versions - retention_count))
                    for (( idx=0; idx<prune_until; idx++ )); do
                        runuser -u "$user" -- env -i PATH="/usr/bin:/bin" rm -rf "${BACKUPS[$idx]}" 9>&-
                    done
                fi
            fi
        else
            error_msg="Failed to clone version $TIMESTAMP"
            log "ERROR: $error_msg"
            REPOS_FAILED+=("$user/$safe_repo: $error_msg")
        fi
    fi

done < "$CONFIG_FILE"

# Determine final status
if [ ${#REPOS_FAILED[@]} -eq 0 ]; then
    FINAL_STATUS="SUCCESS"
else
    FINAL_STATUS="FAILED"
fi

log "GitHub Mirror process finished. Status: $FINAL_STATUS"

if [ "$FINAL_STATUS" = "SUCCESS" ]; then
    log_event "$OK" "GitHub Mirror Process Completed"
else
    log_event "$E_UPDATE" "GitHub Mirror Process Completed with Failures"
fi

# Send email report
if [ -n "$ADMIN_EMAIL" ]; then
    # Convert NOTIFY_ON_SUCCESS to lowercase for reliable comparison
    NOTIFY_ON_SUCCESS_LOWER=$(echo "$NOTIFY_ON_SUCCESS" | tr '[:upper:]' '[:lower:]')
    
    if [ "$FINAL_STATUS" = "FAILED" ] || [ "$NOTIFY_ON_SUCCESS_LOWER" = "true" ]; then
        log "Sending email report to $ADMIN_EMAIL..."
        send_html_email "$FINAL_STATUS" "$ADMIN_EMAIL"
    else
        log "Skipping email report (Success and NOTIFY_ON_SUCCESS=$NOTIFY_ON_SUCCESS)"
    fi
fi
