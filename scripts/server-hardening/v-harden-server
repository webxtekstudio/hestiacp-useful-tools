#!/bin/bash
# Mirrors HestiaCP's global IPv4 ACCEPT port rules into an isolated IPv6 nftables table
# so dual-stack servers do not expose unfirewalled IPv6 ports (while preserving ICMPv6).
set -euo pipefail
export PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"

RULES_CONF="/usr/local/hestia/data/firewall/rules.conf"
SSH_PORT=$({ sshd -T 2>/dev/null || true; } | awk '$1=="port" && !p {p=$2} END{print p ? p : "22"}')

TCP_RAW="$SSH_PORT"
UDP_RAW=""

if [ -f "$RULES_CONF" ]; then
    while IFS=$'\t' read -r proto port; do
        [ -z "$port" ] || [ "$port" = "0" ] && continue
        case "$proto" in
            TCP) TCP_RAW="${TCP_RAW},${port}" ;;
            UDP) UDP_RAW="${UDP_RAW},${port}" ;;
        esac
    done < <(awk '
        function get_val(line, key,    pat, s) {
            pat = key "=\x27[^\x27]*\x27"
            if (match(line, pat)) {
                s = substr(line, RSTART + length(key) + 2, RLENGTH - length(key) - 3)
                gsub(/[\r\n[:space:]]/, "", s)
                return s
            }
            return ""
        }
        /^[[:space:]]*#/ || NF == 0 { next }
        {
            susp = get_val($0, "SUSPENDED")
            act  = get_val($0, "ACTION")
            ip   = get_val($0, "IP")
            prot = get_val($0, "PROTOCOL")
            port = get_val($0, "PORT")
            if ((susp == "" || susp == "no") && act == "ACCEPT" && (ip == "0.0.0.0/0" || ip == "::/0") && port != "" && port != "0") {
                print prot "\t" port
            }
        }
    ' "$RULES_CONF")
fi

TCP_SET=$(printf '%s\n' "$TCP_RAW" | tr ',' '\n' | sed 's/:/-/g' | grep -E '^[0-9]+(-[0-9]+)?$' | sort -u | paste -sd, - | sed 's/,/, /g')
UDP_SET=$(printf '%s\n' "$UDP_RAW" | tr ',' '\n' | sed 's/:/-/g' | grep -E '^[0-9]+(-[0-9]+)?$' | sort -u | paste -sd, - | sed 's/,/, /g' || true)

