#!/bin/bash
# Exempts the active SSH port at index 0 of CrowdSec's nftables input chains so
# shared commercial VPN IPs on external blocklists never lock admins out of SSH.
# Local Fail2Ban continues protecting SSH authentication attempts.
export PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
SSH_PORT=$({ sshd -T 2>/dev/null || true; } | awk '$1=="port" && !p {p=$2} END{print p ? p : "22"}')

for _ in 1 2 3 4 5; do
    nft list chain ip crowdsec crowdsec-chain-input >/dev/null 2>&1 && break
    sleep 1
done

if nft list chain ip crowdsec crowdsec-chain-input >/dev/null 2>&1; then
    if ! nft list chain ip crowdsec crowdsec-chain-input | awk -v p="$SSH_PORT" '$0 ~ ("(^|[[:space:]])tcp dport " p "([[:space:]]|$)") && /[[:space:]]accept([[:space:]]|$)/{ok=1; exit} /[[:space:]](drop|reject)([[:space:]]|$)/{exit} END{exit(ok?0:1)}'; then
        nft insert rule ip crowdsec crowdsec-chain-input tcp dport "${SSH_PORT}" accept
    fi
fi

