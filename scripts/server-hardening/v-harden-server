    echo "delete table ip6 hestia_ipv6_guard"
    echo "table ip6 hestia_ipv6_guard {"
    echo "    chain input {"
    echo "        type filter hook input priority filter + 5; policy drop;"
    echo "        iifname \"lo\" accept"
    echo "        ct state established,related accept"
    echo "        ct state invalid drop"
    echo "        ip6 nexthdr ipv6-icmp accept"
    echo "        udp dport 546 accept"
    if [ -n "$TCP_SET" ]; then
        echo "        tcp dport { $TCP_SET } accept"
    fi
    if [ -n "$UDP_SET" ]; then
        echo "        udp dport { $UDP_SET } accept"
    fi
    echo "    }"
    echo "}"
} > "$TMP_NFT"

nft -f "$TMP_NFT"
EOF

