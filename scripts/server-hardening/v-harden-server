    if ! nft list chain ip6 crowdsec6 crowdsec6-chain-input | awk -v p="$SSH_PORT" '$0 ~ ("(^|[[:space:]])tcp dport " p "([[:space:]]|$)") && /[[:space:]]accept([[:space:]]|$)/{ok=1; exit} /[[:space:]](drop|reject)([[:space:]]|$)/{exit} END{exit(ok?0:1)}'; then
        nft insert rule ip6 crowdsec6 crowdsec6-chain-input tcp dport "${SSH_PORT}" accept
    fi
fi
EOF
    chmod 0755 "$CS_SSH_EXEMPT_BIN"

