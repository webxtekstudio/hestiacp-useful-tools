#!/bin/bash
# =============================================================================
# v-harden-server -- HestiaCP 6-Pillar Server Hardening & CrowdSec IPS Manager
#
# Automates production-tested Linux, Firewall, Fail2Ban, IPv6, and CrowdSec
# security hardening tailored specifically for HestiaCP (Debian / Ubuntu)
# without breaking panel updates, Apache/Nginx ports, or SSH access.
#
# THE 6 PILLARS:
#   1. Kernel Sysctl Hardening (/etc/sysctl.d/99-hestiacp-hardening.conf)
#      SYN cookies, rp_filter, ICMP redirect/source-route blocks, SUID dump
#      protection, and kernel panic auto-reboot (preserves TCP cubic).
#   2. APT Config Preservation (/etc/apt/apt.conf.d/99-keep-custom-configs)
#      Prevents unattended/manual apt upgrades from overwriting custom /etc
#      configs (--force-confdef --force-confold) and locks /etc/crontab (0600).
#   3. Lockout-Safe SSH Hardening (/etc/ssh/sshd_config.d/00-hardening.conf)
#      Sets MaxAuthTries 3, keepalives, and disables PasswordAuthentication
#      ONLY after verifying at least one valid SSH public key is authorized.
#      Validates syntax with 'sshd -t' before reload with automatic rollback.
#   4. Dual-Stack IPv6 Firewall Mirror (hestia-ipv6-guard.service)
#      HestiaCP's native firewall (v-update-firewall) is IPv4-only, leaving
#      ip6tables at INPUT ACCEPT on dual-stack cloud servers. Builds an
#      isolated nftables 'table ip6 hestia_ipv6_guard' mirroring HestiaCP's
#      open global TCP/UDP ports + essential ICMPv6 Neighbor Discovery.
#   5. Upgrade-Proof Web/Webmail Fail2Ban Filters & Desync Auto-Healer
#      Deploys .local filter overrides (wordpress-xmlrpc.local for xmlrpc.php +
#      wp-login.php, and roundcube-auth.local fixing Nginx proxy log matching),
#      enables Roundcube jail when active (validated via 'fail2ban-client -t'),
#      and heals post-update Fail2Ban <-> iptables chain desyncs.
#   6. CrowdSec Collaborative IPS + Upgrade-Immune nftables Bouncer (--crowdsec)
#      - Isolates CrowdSec LAPI on 127.0.0.1:8099 (zero port conflict with
#        HestiaCP's Apache2 on :8080/:8081/:8443 or Nginx on :8084).
#      - Auto-detects active HestiaCP stack from hestia.conf (Nginx-only vs
#        Nginx+Apache2, Exim4/Postfix/Dovecot, VSFTPD/ProFTPD, MariaDB/PgSQL,
#        Roundcube) + HestiaCP :8083 auth, Nextcloud sync whitelist, and
#        Multi-CMS login brute-force (WordPress, Drupal, Nextcloud, Laravel,
#        Symfony, PrestaShop, OpenCart, DokuWiki, MediaWiki) validated with
#        'crowdsec -t' before reload.
#      - Runs nftables bouncer in isolated tables (crowdsec / crowdsec6) so
#        HestiaCP's v-update-firewall (iptables -F) never wipes CrowdSec bans.
#      - Enforces SSH Port Anti-Lockout Exemption at index 0 of CrowdSec input
#        chains so admins on shared VPNs are never locked out by global lists.
#
# USAGE:
#   v-harden-server                  # Apply Pillars 1-5 (fast OS/F2B/IPv6 baseline)
#   v-harden-server --crowdsec       # Install & configure Pillar 6 (CrowdSec IPS)
#   v-harden-server --all            # Apply all 6 Pillars (Pillars 1-5 + CrowdSec)
#   v-harden-server --status         # Read-only status audit of all 6 Pillars
#   v-harden-server --dry-run        # Preview actions without modifying files
#   v-harden-server --cron-heal      # Quiet post-update sync (IPv6 + F2B + CrowdSec)
#   v-harden-server --whitelist CIDR # Whitelist IP/CIDR in CrowdSec + Fail2Ban
#   v-harden-server --unban IP       # Unban IP across CrowdSec, Hestia & Fail2Ban
#
# Part of: https://github.com/webxtekstudio/hestiacp-useful-tools
# =============================================================================

set -euo pipefail
export PATH="/usr/local/hestia/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"

# --- Formatting --------------------------------------------------------------
GREEN='\033[0;32m'
RED='\033[0;31m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

# --- Paths -------------------------------------------------------------------
HESTIA_CONF="/usr/local/hestia/conf/hestia.conf"
SYSCTL_FILE="/etc/sysctl.d/99-hestiacp-hardening.conf"
APT_KEEP_FILE="/etc/apt/apt.conf.d/99-keep-custom-configs"
SSH_DROPIN="/etc/ssh/sshd_config.d/00-hardening.conf"
WP_FILTER_LOCAL="/etc/fail2ban/filter.d/wordpress-xmlrpc.local"
RC_FILTER_LOCAL="/etc/fail2ban/filter.d/roundcube-auth.local"
RC_JAIL_LOCAL="/etc/fail2ban/jail.d/98-hestia-roundcube.local"
CUSTOM_F2B_WL="/etc/fail2ban/jail.d/99-custom-whitelist.local"
IPV6_GUARD_BIN="/opt/webxtek-scripts/hestia-ipv6-guard.sh"
IPV6_GUARD_SVC="/etc/systemd/system/hestia-ipv6-guard.service"
CS_SSH_EXEMPT_BIN="/opt/webxtek-scripts/crowdsec-ssh-exempt.sh"
CS_BOUNCER_DROPIN="/etc/systemd/system/crowdsec-firewall-bouncer.service.d/ssh-exempt.conf"
CS_LOCAL_PARSER="/etc/crowdsec/parsers/s01-parse/hestiacp-local-logs.yaml"
CS_LOCAL_SCENARIOS="/etc/crowdsec/scenarios/hestiacp-local-scenarios.yaml"
CS_LAPI_ADDR="127.0.0.1:8099"
CS_ALLOWLIST_NAME="hestia_trusted"

# --- Mode flags --------------------------------------------------------------
MODE="apply_base"
WITH_CROWDSEC=false
DRY_RUN=false
WHITELIST_TARGET=""
UNBAN_TARGET=""

if [ "$EUID" -ne 0 ]; then
    echo -e "${RED}ERROR: Please run as root (or use sudo).${NC}"
    exit 1
fi

while [[ $# -gt 0 ]]; do
    case "$1" in
        --apply)
            MODE="apply_base"
            shift
            ;;
        --crowdsec)
            MODE="crowdsec_only"
            WITH_CROWDSEC=true
            shift
            ;;
        --all)
            MODE="apply_all"
            WITH_CROWDSEC=true
            shift
            ;;
        --status)
            MODE="status"
            shift
            ;;
        --dry-run)
            DRY_RUN=true
            shift
            ;;
        --cron-heal)
            MODE="cron_heal"
            shift
            ;;
        --whitelist)
            if [ -n "${2:-}" ]; then
                MODE="whitelist"
                WHITELIST_TARGET="$2"
                shift 2
            else
                echo -e "${RED}ERROR: --whitelist requires an IP or CIDR (e.g. 198.51.100.10/32).${NC}"
                exit 1
            fi
            ;;
        --unban)
            if [ -n "${2:-}" ]; then
                MODE="unban"
                UNBAN_TARGET="$2"
                shift 2
            else
                echo -e "${RED}ERROR: --unban requires an IP address.${NC}"
                exit 1
            fi
            ;;
        --help|-h)
            cat << 'HELP'
Usage: v-harden-server [OPTIONS]

Options:
  (no args), --apply   Apply Pillars 1-5 (Kernel, APT, safe SSH, IPv6 Guard, WP Fail2Ban)
  --crowdsec           Install & configure Pillar 6 (CrowdSec + nftables bouncer + SSH anti-lockout)
  --all                Apply all 6 Pillars (Pillars 1-5 + CrowdSec IPS)
  --status             Read-only audit of all 6 security pillars
  --dry-run            Preview planned changes without writing files
  --cron-heal          Silent post-update healer (syncs IPv6 firewall, F2B chains & CrowdSec SSH rule)
  --whitelist <CIDR>   Permanently whitelist an IP/CIDR across CrowdSec & Fail2Ban
  --unban <IP>         Unban an IP across CrowdSec, HestiaCP firewall, and all Fail2Ban jails
  --help, -h           Show this help message
HELP
            exit 0
            ;;
        *)
            echo -e "${RED}Unknown option: $1${NC}"
            echo "Run 'v-harden-server --help' for usage."
            exit 1
            ;;
    esac
done

# --- Helpers -----------------------------------------------------------------
detect_ssh_port() {
    local p=""
    if command -v sshd >/dev/null 2>&1; then
        p=$({ sshd -T 2>/dev/null || true; } | awk '$1=="port" && !p {p=$2} END{print p}')
    fi
    echo "${p:-22}"
}

validate_ip_or_cidr() {
    local target="$1"
    local allow_cidr="${2:-yes}"
    if command -v python3 >/dev/null 2>&1; then
        python3 - "$target" "$allow_cidr" << 'PY' 2>/dev/null
import ipaddress, sys
val, allow_cidr = sys.argv[1], sys.argv[2]
if allow_cidr == "yes":
    ipaddress.ip_network(val, strict=False)
else:
    ipaddress.ip_address(val)
PY
        return $?
    fi
    [[ "$target" =~ ^[0-9a-fA-F:./]+$ ]]
}

has_authorized_ssh_key() {
    local key_files=("/root/.ssh/authorized_keys")
    if [ -n "${SUDO_USER:-}" ] && [ "$SUDO_USER" != "root" ]; then
        local uhome
        uhome=$(getent passwd "$SUDO_USER" | cut -d: -f6 || true)
        [ -n "$uhome" ] && key_files+=("$uhome/.ssh/authorized_keys")
    fi
    for kf in "${key_files[@]}"; do
        if [ -s "$kf" ] && grep -qE '^(ssh-(rsa|ed25519)|ecdsa-sha2-)' "$kf" 2>/dev/null; then
            return 0
        fi
    done
    return 1
}

get_hestia_conf_val() {
    local key="$1"
    [ -f "$HESTIA_CONF" ] || return 0
    awk -v k="$key" '
        {
            pat = "^[[:space:]]*" k "=\x27[^\x27]*\x27"
            if (match($0, pat)) {
                s = substr($0, RSTART, RLENGTH)
                sub(/^[[:space:]]*[^\x27]*\x27/, "", s)
                sub(/\x27$/, "", s)
                print s
                exit
            }
        }
    ' "$HESTIA_CONF"
}

check_f2b_desync_count() {
    command -v fail2ban-client >/dev/null 2>&1 || { echo "0"; return 0; }
    local desync=0
    local pairs="wordpress-xmlrpc:WEB roundcube-auth:WEB phpmyadmin-auth:WEB dovecot-iptables:MAIL exim-iptables:MAIL ssh-iptables:SSH vsftpd-iptables:FTP proftpd-iptables:FTP mysqld-iptables:DB hestia-iptables:HESTIA recidive:RECIDIVE"
    for pair in $pairs; do
        local jail="${pair%%:*}"
        local chain="fail2ban-${pair##*:}"
        if fail2ban-client status "$jail" >/dev/null 2>&1; then
            local f2b_bans ipt_rules
            f2b_bans=$(fail2ban-client status "$jail" 2>/dev/null | awk '/Currently banned:/{print $NF}')
            ipt_rules=$(iptables -L "$chain" -n 2>/dev/null | grep -cE 'REJECT|DROP' || true)
            if [ "${f2b_bans:-0}" -gt 0 ] && [ "${ipt_rules:-0}" -eq 0 ]; then
                desync=$((desync + 1))
            fi
        fi
    done
    echo "$desync"
}

write_file_if_changed() {
    local dest="$1"
    local mode="$2"
    local dir base tmp
    dir="$(dirname "$dest")"
    base="$(basename "$dest")"
    install -d -m 0755 "$dir"
    tmp=$(mktemp "${dir}/.${base}.tmp.XXXXXX")
    chmod "$mode" "$tmp"
    cat > "$tmp"
    if [ -f "$dest" ] && cmp -s "$tmp" "$dest"; then
        chmod "$mode" "$dest" 2>/dev/null || true
        rm -f "$tmp"
        return 1
    fi
    mv -f "$tmp" "$dest"
    chmod "$mode" "$dest"
    return 0
}

is_apt_locked() {
    if command -v fuser >/dev/null 2>&1; then
        fuser /var/lib/dpkg/lock-frontend >/dev/null 2>&1 && return 0
        fuser /var/lib/dpkg/lock >/dev/null 2>&1 && return 0
    fi
    return 1
}

has_ssh_exempt_before_drop() {
    local fam="$1" tbl="$2" chn="$3" port="$4"
    nft list chain "$fam" "$tbl" "$chn" 2>/dev/null | awk -v p="$port" '
        $0 ~ ("(^|[[:space:]])tcp dport " p "([[:space:]]|$)") && /[[:space:]]accept([[:space:]]|$)/ { ok=1; exit }
        /[[:space:]](drop|reject)([[:space:]]|$)/ { exit }
        END { exit(ok ? 0 : 1) }
    '
}

# =============================================================================
# ACTION: UNBAN IP
# =============================================================================
if [ "$MODE" = "unban" ]; then
    if ! validate_ip_or_cidr "$UNBAN_TARGET" "no"; then
        echo -e "${RED}ERROR: Invalid IP address '$UNBAN_TARGET'. Provide a single IPv4 or IPv6 address.${NC}"
        exit 1
    fi
    echo -e "${BLUE}=== Unbanning IP across all security layers: $UNBAN_TARGET ===${NC}"
    if command -v cscli >/dev/null 2>&1; then
        cscli decisions delete --ip "$UNBAN_TARGET" 2>/dev/null && \
            echo -e "  -> ${GREEN}[CrowdSec]${NC} Cleared decisions for $UNBAN_TARGET" || true
    fi
    if [ -x /usr/local/hestia/bin/v-list-firewall-ban ]; then
        for chain in SSH WEB MAIL DNS FTP HESTIA RECIDIVE; do
            /usr/local/hestia/bin/v-delete-firewall-ban "$UNBAN_TARGET" "$chain" >/dev/null 2>&1 && \
                echo -e "  -> ${GREEN}[HestiaCP]${NC} Removed $UNBAN_TARGET from chain $chain" || true
        done
    fi
    if command -v fail2ban-client >/dev/null 2>&1; then
        for jail in $(fail2ban-client status 2>/dev/null | sed -n 's/.*Jail list:[[:space:]]*//p' | tr ',' ' '); do
            if fail2ban-client status "$jail" 2>/dev/null | grep -qF "$UNBAN_TARGET"; then
                fail2ban-client set "$jail" unbanip "$UNBAN_TARGET" >/dev/null 2>&1 && \
                    echo -e "  -> ${GREEN}[Fail2Ban]${NC} Unbanned $UNBAN_TARGET from $jail" || true
            fi
        done
    fi
    exit 0
fi

# =============================================================================
# ACTION: WHITELIST IP / CIDR
# =============================================================================
if [ "$MODE" = "whitelist" ]; then
    if ! validate_ip_or_cidr "$WHITELIST_TARGET" "yes"; then
        echo -e "${RED}ERROR: Invalid IP or CIDR '$WHITELIST_TARGET' (example: 198.51.100.10/32 or 2001:db8::/64).${NC}"
        exit 1
    fi
    echo -e "${BLUE}=== Whitelisting trusted IP/CIDR: $WHITELIST_TARGET ===${NC}"
    if command -v cscli >/dev/null 2>&1; then
        cscli allowlists create "$CS_ALLOWLIST_NAME" -d "Trusted admin & server IPs" >/dev/null 2>&1 || true
        cscli allowlists add "$CS_ALLOWLIST_NAME" "$WHITELIST_TARGET" && \
            echo -e "  -> ${GREEN}[CrowdSec]${NC} Added $WHITELIST_TARGET to allowlist '$CS_ALLOWLIST_NAME'"
    fi
    mkdir -p /etc/fail2ban/jail.d
    existing_ips="127.0.0.1/8 ::1"
    if [ -f "$CUSTOM_F2B_WL" ] && [ ! -L "$CUSTOM_F2B_WL" ]; then
        parsed_ips=$(awk -F= '/^[[:space:]]*ignoreip[[:space:]]*=/{sub(/^[[:space:]]+/, "", $2); sub(/[[:space:]]+$/, "", $2); gsub(/[[:space:]]+/, " ", $2); print $2; exit}' "$CUSTOM_F2B_WL")
        [ -n "$parsed_ips" ] && existing_ips="$parsed_ips"
    fi
    if ! printf ' %s ' "$existing_ips" | grep -Fq -- " $WHITELIST_TARGET "; then
        existing_ips="$existing_ips $WHITELIST_TARGET"
    fi
    tmp_wl=$(umask 077 && mktemp /etc/fail2ban/jail.d/.99-hestia-whitelist.XXXXXX)
    cat << EOF > "$tmp_wl"
# Managed by v-harden-server (hestiacp-useful-tools)
[DEFAULT]
ignoreip = $existing_ips
EOF
    chown root:root "$tmp_wl"
    chmod 0644 "$tmp_wl"
    mv -f "$tmp_wl" "$CUSTOM_F2B_WL"
    if command -v fail2ban-client >/dev/null 2>&1 && systemctl is-active --quiet fail2ban; then
        for jail in $(fail2ban-client status 2>/dev/null | sed -n 's/.*Jail list:[[:space:]]*//p' | tr ',' ' '); do
            fail2ban-client set "$jail" addignoreip "$WHITELIST_TARGET" >/dev/null 2>&1 || true
        done
    fi
    echo -e "  -> ${GREEN}[Fail2Ban]${NC} Persisted $WHITELIST_TARGET in $CUSTOM_F2B_WL"
    exit 0
fi

# =============================================================================
# ACTION: STATUS AUDIT (READ-ONLY)
# =============================================================================
if [ "$MODE" = "status" ]; then
    SSH_PORT=$(detect_ssh_port)
    echo -e "${BLUE}=================================================================${NC}"
    echo -e "${BLUE} HestiaCP Server Hardening Status (v-harden-server)${NC}"
    echo -e "${BLUE}=================================================================${NC}"

    # 1. Kernel sysctl
    if [ -f "$SYSCTL_FILE" ] && [ "$(sysctl -n net.ipv4.tcp_syncookies 2>/dev/null)" = "1" ] && [ "$(sysctl -n fs.suid_dumpable 2>/dev/null)" = "0" ]; then
        echo -e "  [1] Kernel Sysctl Hardening:   ${GREEN}ACTIVE${NC} ($SYSCTL_FILE, congestion=$(sysctl -n net.ipv4.tcp_congestion_control 2>/dev/null))"
    else
        echo -e "  [1] Kernel Sysctl Hardening:   ${YELLOW}NOT APPLIED${NC}"
    fi

    # 2. APT preservation
    if [ -f "$APT_KEEP_FILE" ]; then
        echo -e "  [2] APT Config Preservation:   ${GREEN}ACTIVE${NC} ($APT_KEEP_FILE)"
    else
        echo -e "  [2] APT Config Preservation:   ${YELLOW}MISSING${NC}"
    fi

    # 3. SSH hardening
    sshd_dump=$(sshd -T 2>/dev/null || true)
    pw_auth=$(printf '%s\n' "$sshd_dump" | awk '$1=="passwordauthentication" && !v {v=$2} END{print v ? v : "unknown"}')
    max_tries=$(printf '%s\n' "$sshd_dump" | awk '$1=="maxauthtries" && !v {v=$2} END{print v ? v : "unknown"}')
    if [ "$pw_auth" = "no" ]; then
        echo -e "  [3] SSH Hardening (Port $SSH_PORT):   ${GREEN}ACTIVE${NC} (PasswordAuthentication=no, MaxAuthTries=$max_tries)"
    else
        echo -e "  [3] SSH Hardening (Port $SSH_PORT):   ${YELLOW}PARTIAL${NC} (PasswordAuthentication=$pw_auth, MaxAuthTries=$max_tries)"
    fi

    # 4. IPv6 Guard
    has_global_v6=$(ip -6 addr show scope global 2>/dev/null | grep -c 'inet6' || true)
    if [ "$has_global_v6" -eq 0 ]; then
        echo -e "  [4] IPv6 Firewall Guard:       ${GREEN}N/A${NC} (No global IPv6 address assigned)"
    elif nft list table ip6 hestia_ipv6_guard >/dev/null 2>&1; then
        echo -e "  [4] IPv6 Firewall Guard:       ${GREEN}ACTIVE${NC} (nftables table ip6 hestia_ipv6_guard)"
    else
        echo -e "  [4] IPv6 Firewall Guard:       ${RED}EXPOSED${NC} (Global IPv6 active without hestia_ipv6_guard)"
    fi

    # 5. Web/Webmail Fail2Ban + Sync
    if ! command -v fail2ban-client >/dev/null 2>&1 || [ ! -d /etc/fail2ban ]; then
        echo -e "  [5] Fail2Ban Filters & Sync:   ${GREEN}N/A${NC} (Fail2Ban not installed)"
    else
        desync=$(check_f2b_desync_count)
        rc_state="n/a"
        if [ "$(get_hestia_conf_val WEBMAIL_SYSTEM)" = "roundcube" ]; then
            if [ -f "$RC_FILTER_LOCAL" ] && fail2ban-client status roundcube-auth >/dev/null 2>&1; then
                rc_state="roundcube=on"
            elif [ -f "$RC_FILTER_LOCAL" ]; then
                rc_state="roundcube=filter-ready"
            else
                rc_state="roundcube=unpatched"
            fi
        fi
        if { [ -f "$WP_FILTER_LOCAL" ] && grep -q 'wp-login' "$WP_FILTER_LOCAL" 2>/dev/null; } || grep -q 'wp-login' /etc/fail2ban/filter.d/wordpress-xmlrpc.conf 2>/dev/null; then
            if [ "$desync" -eq 0 ]; then
                echo -e "  [5] Fail2Ban Filters & Sync:   ${GREEN}ACTIVE${NC} (wp-login+xmlrpc, $rc_state, 0 chain desyncs)"
            else
                echo -e "  [5] Fail2Ban Filters & Sync:   ${RED}DESYNCED${NC} ($desync jail(s) missing iptables rules)"
            fi
        else
            echo -e "  [5] Fail2Ban Filters & Sync:   ${YELLOW}MISSING .local FILTERS${NC}"
        fi
    fi

    # 6. CrowdSec
    if systemctl is-active --quiet crowdsec 2>/dev/null && systemctl is-active --quiet crowdsec-firewall-bouncer 2>/dev/null; then
        ssh_exempt="NO"
        v4_ok=false
        v6_ok=true
        if has_ssh_exempt_before_drop ip crowdsec crowdsec-chain-input "$SSH_PORT"; then
            v4_ok=true
        fi
        if nft list chain ip6 crowdsec6 crowdsec6-chain-input >/dev/null 2>&1; then
            if ! has_ssh_exempt_before_drop ip6 crowdsec6 crowdsec6-chain-input "$SSH_PORT"; then
                v6_ok=false
            fi
        fi
        if [ "$v4_ok" = true ] && [ "$v6_ok" = true ]; then
            ssh_exempt="YES (Port $SSH_PORT IPv4/IPv6)"
        fi
        multi_cms="base"
        if [ -f "$CS_LOCAL_SCENARIOS" ] && [ -f "$CS_LOCAL_PARSER" ]; then
            multi_cms="Hestia+Roundcube+Multi-CMS"
        fi
        echo -e "  [6] CrowdSec + nft Bouncer:    ${GREEN}ACTIVE${NC} (LAPI $CS_LAPI_ADDR | Profiles: $multi_cms | SSH Exempt: $ssh_exempt)"
    else
        echo -e "  [6] CrowdSec + nft Bouncer:    ${YELLOW}NOT INSTALLED${NC} (run 'v-harden-server --crowdsec')"
    fi
    exit 0
fi

sync_nginx_edge_hardening() {
    local quiet="${1:-false}"
    if [ -d /etc/nginx ] && command -v nginx >/dev/null 2>&1; then
        # Never touch domain configs if nginx syntax is already broken before we start
        if ! nginx -t >/dev/null 2>&1; then
            [ "$quiet" = "false" ] && echo -e "  -> ${YELLOW}[Pillar 5 Warning]${NC} nginx -t is currently failing -- skipping Nginx edge hardening sync to avoid masking existing syntax errors"
            return 0
        fi
        local nginx_hardening_changed=false
        local touched_domains=()
        for dconf_dir in /home/*/conf/web/*; do
            [ -d "$dconf_dir" ] || continue
            [ -f "$dconf_dir/nginx.conf" ] || continue
            local dom_name
            dom_name=$(basename "$dconf_dir")
            local h_conf="$dconf_dir/nginx.conf_hardening"
            local h_ssl_conf="$dconf_dir/nginx.ssl.conf_hardening"
            # Respect manual per-domain opt-out (# custom-override or # unmanaged)
            if [ -f "$h_conf" ] && grep -qiE '^#\s*(custom-override|unmanaged)' "$h_conf" 2>/dev/null; then
                continue
            fi
            if sed "s/__DOMAIN__/${dom_name}/g" << 'EOF' | write_file_if_changed "$h_conf" 0644
# Managed by v-harden-server (hestiacp-useful-tools)
# Add '# custom-override' on line 1 to prevent automatic updates on this domain
# Edge block for PHP execution in uploads, wp-config probes, and path traversal (LFI)
location ~* /(?:wp-content/uploads|uploads)/.*\.php(?:[0-9]|s|tml|ar)?$ {
    access_log /var/log/nginx/domains/__DOMAIN__.log main;
    deny all;
    return 403;
}
location = /__hestia_edge_block__ {
    internal;
    access_log /var/log/nginx/domains/__DOMAIN__.log main;
    return 403;
}
if ($request_uri ~* "(?:/wp-config(?:\.php|[-_.][a-z0-9]+)|\.\./|\.\.\\|%2e%2e)") {
    rewrite ^ /__hestia_edge_block__ last;
}
EOF
            then
                nginx_hardening_changed=true
                touched_domains+=("$dconf_dir")
            fi
            if [ -f "$dconf_dir/nginx.ssl.conf" ] && [ ! -L "$h_ssl_conf" ]; then
                ln -sf "$h_conf" "$h_ssl_conf"
                nginx_hardening_changed=true
                touched_domains+=("$dconf_dir")
            fi
        done

        if [ "$nginx_hardening_changed" = true ]; then
            if nginx -t >/dev/null 2>&1; then
                systemctl reload nginx >/dev/null 2>&1 || true
                [ "$quiet" = "false" ] && echo -e "  -> ${GREEN}[Pillar 5]${NC} Nginx edge hardening (uploads PHP + wp-config/LFI block) updated & reloaded"
            else
