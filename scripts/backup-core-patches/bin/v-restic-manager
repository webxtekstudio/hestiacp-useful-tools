#!/usr/bin/env bash
# info: manage HestiaCP Restic incremental backups, offline Master Recovery Key enrollment, daily execution, and .tar export
# options: --init-master-key [--print] | --enroll | --run-daily | --status | --export-tar USER [SNAPSHOT] [OUTPUT_TAR] [--no-register] | --dump-tar USER [SNAPSHOT] OUTPUT_TAR [SUBPATH] | --help
#
# Hardens HestiaCP's native Restic incremental backups:
#   1. Generates and protects an offline Master Recovery Key (/etc/hestiacp-restic-master.key, 0400 root:root)
#   2. Auto-enrolls the Master Recovery Key across every active user's Restic repository (dual-key unlock)
#   3. Enforces 0600 root:root on /usr/local/hestia/data/users/*/restic.conf and 0660 on conf/restic.conf
#   4. Deletes /home/<user>/backup immediately after each Restic snapshot so shadow/SSL/SQL staging dumps never linger
#   5. Refreshes v-verify-backups and dispatches alerts (email + optional RESTIC_FAILURE_HOOK) ONLY on failure

export HOME="${HOME:-/root}"
set -uo pipefail

if [ -z "${HESTIA:-}" ] && [ -f /etc/hestiacp/hestia.conf ]; then
    # shellcheck disable=SC1091
    source /etc/hestiacp/hestia.conf
fi
HESTIA="${HESTIA:-/usr/local/hestia}"
BIN="$HESTIA/bin"
if [ "$HESTIA" = "/usr/local/hestia" ] && [ "${RESTIC_MANAGER_ALLOW_NONROOT:-0}" != "1" ]; then
    export PATH="$BIN:/usr/local/sbin:/usr/local/bin:/sbin:/bin:/usr/sbin:/usr/bin:$PATH"
else
    export PATH="$PATH:$BIN:/usr/local/sbin:/usr/local/bin:/sbin:/bin:/usr/sbin:/usr/bin"
fi
HESTIA_LOG="$HESTIA/log/backup.log"
HESTIA_HOME_ROOT="${HESTIA_HOME_ROOT:-/home}"
MASTER_KEY_FILE="${RESTIC_MASTER_KEY_FILE:-/etc/hestiacp-restic-master.key}"
LOCK_FILE="${RESTIC_LOCK_FILE:-/run/hestia-restic-daily.lock}"
VERIFY_STATUS_FILE="${RESTIC_VERIFY_STATUS_FILE:-/var/log/hestia/backup-verify.status}"

ACTION=""
PRINT_KEY=false
REGISTER_EXPORT=true
POSITIONAL_ARGS=()

print_usage() {
    cat << 'EOF'
Usage: v-restic-manager <ACTION> [OPTIONS]

Actions:
  --init-master-key [--print]                  Generate /etc/hestiacp-restic-master.key (0400 root:root) if missing
  --enroll                                     Enable BACKUPS_INCREMENTAL='yes', lock restic.conf (0600), and enroll Master Key on all active repos
  --run-daily                                  Run daily Restic snapshots for all active users, enroll Master Key, clean staging dirs, and alert on error
  --status                                     Show Restic configuration, Master Key protection, and per-user repository status
  --export-tar USER [SNAPSHOT] [OUTPUT_TAR]    Reconstruct a HestiaCP v-restore-user compatible .tar archive from a Restic snapshot
                                               (defaults to SNAPSHOT='latest' and OUTPUT_TAR='/backup/<user>.<date>.tar', registering it in HestiaCP;
                                                pass --no-register to skip adding the exported archive to data/users/<user>/backup.conf)
  --dump-tar USER [SNAPSHOT] OUTPUT_TAR [PATH] Stream a raw tar archive directly from Restic (defaults to SNAPSHOT='latest' and PATH='/home/<user>')
  --help, -h                                   Show this help message
EOF
}

for arg in "$@"; do
    case "$arg" in
        --init-master-key|--enroll|--run-daily|--status|--export-tar|--dump-tar)
            if [ -n "$ACTION" ] && [ "$ACTION" != "$arg" ]; then
                echo "ERROR: Specify only one action flag." >&2
                exit 2
            fi
            ACTION="$arg"
            ;;
        --print)
            PRINT_KEY=true
            ;;
        --no-register)
            REGISTER_EXPORT=false
            ;;
        --help|-h)
            print_usage
            exit 0
            ;;
        --*)
            echo "ERROR: Unknown option: $arg" >&2
            print_usage >&2
            exit 2
            ;;
        *)
            POSITIONAL_ARGS+=("$arg")
            ;;
    esac
done

if [ -z "$ACTION" ]; then
    print_usage >&2
    exit 2
fi

if [ "${EUID:-$(id -u)}" -ne 0 ] && [ "${RESTIC_MANAGER_ALLOW_NONROOT:-0}" != "1" ]; then
    echo "ERROR: v-restic-manager must be run as root." >&2
    exit 1
fi

load_hestia_restic_conf() {
    # shellcheck disable=SC1091
    [ -f "$HESTIA/conf/hestia.conf" ] && source "$HESTIA/conf/hestia.conf"

    REPO=""
    SNAPSHOTS=""
    KEEP_DAILY=""
    KEEP_WEEKLY=""
    KEEP_MONTHLY=""
    KEEP_YEARLY=""
    if [ -f "$HESTIA/conf/restic.conf" ]; then
        chown root:root "$HESTIA/conf/restic.conf" 2>/dev/null || true
        chmod 0660 "$HESTIA/conf/restic.conf" 2>/dev/null || true
        # shellcheck disable=SC1091
        source "$HESTIA/conf/restic.conf"
    fi
}

enable_incremental_on_conf() {
    local conf_file="$1"
    [ -f "$conf_file" ] || return 0
    if grep -q "^BACKUPS_INCREMENTAL=" "$conf_file" 2>/dev/null; then
        if ! grep -q "^BACKUPS_INCREMENTAL='yes'" "$conf_file" 2>/dev/null; then
            sed -i "s/^BACKUPS_INCREMENTAL=.*/BACKUPS_INCREMENTAL='yes'/" "$conf_file" 2>/dev/null || true
        fi
    else
        echo "BACKUPS_INCREMENTAL='yes'" >> "$conf_file"
    fi
}

enable_incremental_packages() {
    local pkg
    for pkg in "$HESTIA/data/packages"/*.pkg; do
        [ -f "$pkg" ] || continue
        enable_incremental_on_conf "$pkg"
    done
}

list_active_users() {
    if [ -x "$BIN/v-list-sys-users" ]; then
        "$BIN/v-list-sys-users" plain 2>/dev/null
        return 0
    fi
    local d
    for d in "$HESTIA/data/users"/*; do
        [ -d "$d" ] && basename "$d"
    done
}

enroll_master_key_for_user() {
    local user="$1"
    local u_dir="$HESTIA/data/users/$user"
    local u_rconf="$u_dir/restic.conf"

    [ -f "$u_rconf" ] || return 0
    chown root:root "$u_rconf" 2>/dev/null || true
    chmod 0600 "$u_rconf" 2>/dev/null || true

    [ -s "$MASTER_KEY_FILE" ] || return 0
    [ -s "$u_rconf" ] || return 0

    local repo_url="${REPO%/}/$user"
    # Fast check: if Master Key already unlocks this repository, nothing to add
    if restic --repo "$repo_url" --password-file "$MASTER_KEY_FILE" --no-lock key list --json >/dev/null 2>&1; then
        return 0
    fi

    mkdir -p "$(dirname "$HESTIA_LOG")" 2>/dev/null || true
    if restic --repo "$repo_url" --password-file "$u_rconf" key add --new-password-file "$MASTER_KEY_FILE" >> "$HESTIA_LOG" 2>&1; then
        echo "$(date '+%F %T') [KEY] Enrolled Master Recovery Key for $user"
        return 0
    fi

    echo "$(date '+%F %T') [WARN] Failed to enroll Master Recovery Key for $user" >&2
    return 1
}

do_init_master_key() {
    mkdir -p "$(dirname "$MASTER_KEY_FILE")"
    if [ -s "$MASTER_KEY_FILE" ]; then
        chown root:root "$MASTER_KEY_FILE" 2>/dev/null || true
        chmod 0400 "$MASTER_KEY_FILE" 2>/dev/null || true
        echo "[SKIP] Master Recovery Key already exists at $MASTER_KEY_FILE (permissions locked to 0400)."
    else
        local new_key=""
        if command -v openssl >/dev/null 2>&1; then
            new_key="$(openssl rand -base64 64 | tr -dc 'A-Za-z0-9' | head -c 48)"
        else
            new_key="$(tr -dc 'A-Za-z0-9' < /dev/urandom | head -c 48)"
        fi
        if [ "${#new_key}" -lt 32 ]; then
            echo "ERROR: Failed to generate a 48-character Master Recovery Key." >&2
            exit 1
        fi
        (
            umask 077
            printf '%s\n' "$new_key" > "$MASTER_KEY_FILE"
        )
        chown root:root "$MASTER_KEY_FILE" 2>/dev/null || true
        chmod 0400 "$MASTER_KEY_FILE" 2>/dev/null || true
        echo "[OK] Generated new 48-character Master Recovery Key at $MASTER_KEY_FILE (0400 root:root)."
        echo "IMPORTANT: Store a copy of this key in your offline password manager (Bitwarden / 1Password)."
    fi

    if [ "$PRINT_KEY" = true ]; then
        echo "--- MASTER RECOVERY KEY (STORE OFFLINE & DO NOT COMMIT) ---"
        cat "$MASTER_KEY_FILE"
        echo "-----------------------------------------------------------"
    fi
}

do_enroll_all() {
    load_hestia_restic_conf
    if [ "${BACKUP_INCREMENTAL:-no}" != "yes" ] || [ -z "${REPO:-}" ]; then
        echo "ERROR: HestiaCP Restic is not configured (BACKUP_INCREMENTAL!='yes' or REPO empty in $HESTIA/conf/restic.conf)." >&2
        exit 1
    fi
    if [ ! -s "$MASTER_KEY_FILE" ]; then
        echo "ERROR: Master Recovery Key missing at $MASTER_KEY_FILE. Run 'v-restic-manager --init-master-key' first." >&2
        exit 1
    fi

    enable_incremental_packages
    local errs=0
    local checked=0
    local user
    for user in $(list_active_users); do
        local u_conf="$HESTIA/data/users/$user/user.conf"
        [ -f "$u_conf" ] || continue
        grep -q "^SUSPENDED='no'" "$u_conf" 2>/dev/null || continue
        enable_incremental_on_conf "$u_conf"
        checked=$((checked + 1))
        if [ -f "$HESTIA/data/users/$user/restic.conf" ]; then
            enroll_master_key_for_user "$user" || errs=$((errs + 1))
        else
            echo "[INFO] $user: restic.conf not created yet (will be initialized and enrolled on next --run-daily)."
        fi
    done

    [ "$errs" -eq 0 ] || exit 1
    echo "[OK] Verified BACKUPS_INCREMENTAL='yes', 0600 permissions, and Master Recovery Key across $checked active user(s)."
}

do_status() {
    load_hestia_restic_conf
    echo "=== HestiaCP Restic Manager Status ==="
    echo "BACKUP_INCREMENTAL : ${BACKUP_INCREMENTAL:-no}"
    echo "REPO               : ${REPO:-<unconfigured>}"
    echo "RETENTION          : snapshots=${SNAPSHOTS:--1} daily=${KEEP_DAILY:--1} weekly=${KEEP_WEEKLY:--1} monthly=${KEEP_MONTHLY:--1} yearly=${KEEP_YEARLY:--1}"
    if [ -s "$MASTER_KEY_FILE" ]; then
        local mk_mode
        mk_mode="$(stat -c '%a' "$MASTER_KEY_FILE" 2>/dev/null || echo 'unknown')"
        echo "MASTER_KEY_FILE    : $MASTER_KEY_FILE (present, mode=$mk_mode)"
    else
        echo "MASTER_KEY_FILE    : $MASTER_KEY_FILE (MISSING)"
    fi
    echo "--- Active Users ---"
    local user
    for user in $(list_active_users); do
        local u_dir="$HESTIA/data/users/$user"
        local u_conf="$u_dir/user.conf"
        [ -f "$u_conf" ] || continue
        grep -q "^SUSPENDED='no'" "$u_conf" 2>/dev/null || continue
        local inc_flag="no"
        grep -q "^BACKUPS_INCREMENTAL='yes'" "$u_conf" 2>/dev/null && inc_flag="yes"
        if [ -s "$u_dir/restic.conf" ]; then
            local rc_mode
            rc_mode="$(stat -c '%a' "$u_dir/restic.conf" 2>/dev/null || echo '?')"
            local staging_state="clean"
            [ -e "$HESTIA_HOME_ROOT/$user/backup" ] && staging_state="PRESENT"
            printf "  %-22s incremental=%-3s restic.conf=%s staging=%s\n" "$user" "$inc_flag" "$rc_mode" "$staging_state"
        else
            printf "  %-22s incremental=%-3s restic.conf=MISSING\n" "$user" "$inc_flag"
        fi
    done
}

emit_failure_alerts() {
    local failed_list="$1"
    local verify_rc="$2"
    local host_fqdn
    host_fqdn="$(hostname -f 2>/dev/null || hostname)"

    # 1. Invoke optional custom failure hook if configured
    if [ -n "${RESTIC_FAILURE_HOOK:-}" ] && [ -x "$RESTIC_FAILURE_HOOK" ]; then
        "$RESTIC_FAILURE_HOOK" "${failed_list:-none}" "$verify_rc" >/dev/null 2>&1 || true
    fi

    # 2. Send alert email to HestiaCP admin contact
    local root_acct="${ROOT_USER:-admin}"
    local admin_email=""
    if [ -f "$HESTIA/data/users/$root_acct/user.conf" ]; then
        admin_email="$(grep "^CONTACT=" "$HESTIA/data/users/$root_acct/user.conf" | cut -d"'" -f2 || true)"
    fi
    local sendmail_bin="$HESTIA/web/inc/mail-wrapper.php"
    if [ -n "$admin_email" ] && [ -x "$sendmail_bin" ]; then
        {
            echo "Restic daily backup or remote verification reported an error on $host_fqdn at $(date -u '+%F %T UTC')."
            echo ""
            echo "Failed Restic user runs: ${failed_list:-none}"
            echo "v-verify-backups exit code: $verify_rc"
            echo ""
            echo "--- $VERIFY_STATUS_FILE ---"
            cat "$VERIFY_STATUS_FILE" 2>/dev/null || true
        } | "$sendmail_bin" -s "[ALERT] Restic Backup Failure on $host_fqdn" "$admin_email" "yes" || true
    fi
}

run_low_prio() {
    if command -v nice >/dev/null 2>&1 && command -v ionice >/dev/null 2>&1; then
        nice -n 19 ionice -c2 -n7 "$@"
    elif command -v nice >/dev/null 2>&1; then
        nice -n 19 "$@"
    else
        "$@"
    fi
}

do_run_daily() {
    mkdir -p "$(dirname "$LOCK_FILE")" 2>/dev/null || true
    exec 9>"$LOCK_FILE"
    if command -v flock >/dev/null 2>&1; then
        if ! flock -n 9; then
            echo "$(date '+%F %T') [SKIP] Another Restic daily backup is already running."
            exit 0
        fi
    fi

    load_hestia_restic_conf
    if [ "${BACKUP_INCREMENTAL:-no}" != "yes" ] || [ -z "${REPO:-}" ]; then
        echo "$(date '+%F %T') [ERROR] BACKUP_INCREMENTAL is not enabled or REPO is empty in $HESTIA/conf/restic.conf." >&2
        emit_failure_alerts "config_disabled" "1"
        exit 1
    fi

    echo "================================================================="
    echo "$(date '+%F %T') Starting Daily Restic Incremental Backup"
    echo "================================================================="

    if [ "$HESTIA" = "/usr/local/hestia" ] && command -v mysqlrepair >/dev/null 2>&1; then
        mysqlrepair --all-databases --check --auto-repair >/dev/null 2>&1 || true
    fi

    enable_incremental_packages
    mkdir -p "$(dirname "$HESTIA_LOG")" 2>/dev/null || true

    local ok_users=0
    local fail_users=()
    local user

    for user in $(list_active_users); do
        local u_dir="$HESTIA/data/users/$user"
        local u_conf="$u_dir/user.conf"
        [ -f "$u_conf" ] || continue
        grep -q "^SUSPENDED='no'" "$u_conf" 2>/dev/null || continue

        enable_incremental_on_conf "$u_conf"

        echo "$(date '+%F %T') [USER] Backing up $user via Restic..."
        {
            echo "================================"
            echo "$user (restic)"
            echo "--------------------------------"
        } >> "$HESTIA_LOG"

        local user_rc=0
        if ! run_low_prio "$BIN/v-backup-user-restic" "$user" >> "$HESTIA_LOG" 2>&1 9>&-; then
            echo "$(date '+%F %T') [WARN] First Restic attempt failed for $user; retrying in 15s..."
            sleep 15
            if ! run_low_prio "$BIN/v-backup-user-restic" "$user" >> "$HESTIA_LOG" 2>&1 9>&-; then
                user_rc=1
            fi
        fi

        # Immediately remove staging dumps (/home/<user>/backup) and harden restic.conf (0600)
        if [ -n "$user" ] && [[ "$user" =~ ^[A-Za-z0-9._-]+$ ]]; then
            rm -rf -- "$HESTIA_HOME_ROOT/$user/backup" 2>/dev/null || true
        fi
        if [ -f "$u_dir/restic.conf" ]; then
            chown root:root "$u_dir/restic.conf" 2>/dev/null || true
            chmod 0600 "$u_dir/restic.conf" 2>/dev/null || true
        fi

        if [ "$user_rc" -ne 0 ]; then
            echo "$(date '+%F %T') [FAIL] Restic backup failed for $user"
            fail_users+=("$user")
            continue
        fi

        if [ -s "$MASTER_KEY_FILE" ]; then
            enroll_master_key_for_user "$user" 9>&- || fail_users+=("${user}(key_enroll)")
        fi

        ok_users=$((ok_users + 1))
        echo "$(date '+%F %T') [OK] Completed Restic snapshot for $user"
    done

    local verify_rc=0
    if [ -x "$BIN/v-verify-backups" ]; then
        if [ "$HESTIA" = "/usr/local/hestia" ] && [ -f /root/.b2_account_info ]; then
            B2_ACCOUNT_INFO=/root/.b2_account_info "$BIN/v-verify-backups" --status-file="$VERIFY_STATUS_FILE" --quiet 9>&- || verify_rc=$?
        else
            "$BIN/v-verify-backups" --status-file="$VERIFY_STATUS_FILE" --quiet 9>&- || verify_rc=$?
        fi
    fi

    if [ "${#fail_users[@]}" -gt 0 ] || [ "$verify_rc" -ne 0 ]; then
        echo "$(date '+%F %T') [ALERT] Restic daily run finished with errors (failed_users=${#fail_users[@]}, verify_rc=$verify_rc)"
        emit_failure_alerts "${fail_users[*]:-none}" "$verify_rc"
        exit 1
    fi

    echo "$(date '+%F %T') [SUCCESS] Restic daily backup & verification passed for all $ok_users active user(s)."
    exit 0
}

resolve_restic_password_file() {
    local user="$1"
    local u_rconf="$HESTIA/data/users/$user/restic.conf"
    if [ -s "$u_rconf" ]; then
        echo "$u_rconf"
        return 0
    fi
    if [ -s "$MASTER_KEY_FILE" ]; then
        echo "$MASTER_KEY_FILE"
        return 0
    fi
    return 1
}

extract_kv_from_conf() {
    local file="$1" key="$2"
    sed -nE "s/.*(^|[[:space:]])${key}='([^']*)'.*/\2/p" "$file" 2>/dev/null | tail -n 1
}

compress_tar_stream() {
    local mode="$1" lvl="$2" out_file="$3"
    if [ "$mode" = "zstd" ]; then
        if command -v pzstd >/dev/null 2>&1; then
            pzstd -"$lvl" - > "$out_file"
        else
            zstd -"$lvl" -q - > "$out_file"
        fi
    else
        gzip -"$lvl" - > "$out_file"
    fi
}

do_dump_tar() {
    load_hestia_restic_conf
    if [ -z "${REPO:-}" ]; then
        echo "ERROR: REPO is not configured in $HESTIA/conf/restic.conf." >&2
        exit 1
    fi
    local user="${POSITIONAL_ARGS[0]:-}"
    local snapshot="${POSITIONAL_ARGS[1]:-latest}"
    local output_tar="${POSITIONAL_ARGS[2]:-}"
    local subpath="${POSITIONAL_ARGS[3]:-}"

    if [ -z "$user" ] || [ -z "$output_tar" ]; then
        echo "Usage: v-restic-manager --dump-tar <USER> [SNAPSHOT|latest] <OUTPUT_TAR> [SUBPATH]" >&2
        exit 2
    fi
    if [[ ! "$user" =~ ^[A-Za-z0-9._-]+$ ]] || [[ ! "$snapshot" =~ ^[A-Za-z0-9._-]+$ ]]; then
        echo "ERROR: Invalid user or snapshot identifier." >&2
        exit 2
    fi
    [ -z "$subpath" ] && subpath="$HESTIA_HOME_ROOT/$user"

    local pw_file=""
    if ! pw_file="$(resolve_restic_password_file "$user")"; then
        echo "ERROR: Neither $HESTIA/data/users/$user/restic.conf nor $MASTER_KEY_FILE is available." >&2
        exit 1
    fi

    mkdir -p "$(dirname "$output_tar")"
    echo "$(date '+%F %T') [DUMP] Streaming Restic snapshot '$snapshot' ($subpath) for $user to $output_tar..."
    if ! restic --repo "${REPO%/}/$user" --password-file "$pw_file" --no-lock dump "$snapshot" "$subpath" > "$output_tar"; then
        rm -f "$output_tar" 2>/dev/null || true
        echo "ERROR: Failed to stream Restic dump for $user ($snapshot)." >&2
        exit 1
    fi
    chmod 0640 "$output_tar" 2>/dev/null || true
    chown root:hestiaweb "$output_tar" 2>/dev/null || true
    echo "[OK] Raw Restic tar stream written to $output_tar ($(du -sh "$output_tar" | cut -f1))."
}

do_export_tar() {
    load_hestia_restic_conf
    if [ -z "${REPO:-}" ]; then
        echo "ERROR: REPO is not configured in $HESTIA/conf/restic.conf." >&2
        exit 1
    fi

    local user="${POSITIONAL_ARGS[0]:-}"
    local snapshot="${POSITIONAL_ARGS[1]:-latest}"
    local output_tar="${POSITIONAL_ARGS[2]:-}"

    if [ -z "$user" ]; then
        echo "Usage: v-restic-manager --export-tar <USER> [SNAPSHOT|latest] [OUTPUT_TAR] [--no-register]" >&2
        exit 2
    fi
    if [[ ! "$user" =~ ^[A-Za-z0-9._-]+$ ]] || [[ ! "$snapshot" =~ ^[A-Za-z0-9._-]+$ ]]; then
        echo "ERROR: Invalid user or snapshot identifier." >&2
        exit 2
    fi

    local pw_file=""
    if ! pw_file="$(resolve_restic_password_file "$user")"; then
        echo "ERROR: Neither $HESTIA/data/users/$user/restic.conf nor $MASTER_KEY_FILE is available." >&2
        exit 1
    fi

    local backup_root="${BACKUP:-/backup}"
    local temp_root="${BACKUP_TEMP:-$backup_root}"
    mkdir -p "$backup_root" "$temp_root"

    EXPORT_STAGE_DIR="$(umask 077 && mktemp -d -p "$temp_root" "restic-export-${user}.XXXXXX")" || {
        echo "ERROR: Unable to create staging directory in $temp_root." >&2
        exit 1
    }
    trap '[ -n "${EXPORT_STAGE_DIR:-}" ] && rm -rf "$EXPORT_STAGE_DIR" 2>/dev/null || true' EXIT INT TERM

    echo "$(date '+%F %T') [EXPORT] Restoring snapshot '$snapshot' for $user into temporary staging area..."
    if ! restic --repo "${REPO%/}/$user" --password-file "$pw_file" --no-lock restore "$snapshot" --target "$EXPORT_STAGE_DIR" >/dev/null; then
        echo "ERROR: Failed to extract Restic snapshot '$snapshot' for $user." >&2
        exit 1
    fi

    local snap_home="$EXPORT_STAGE_DIR${HESTIA_HOME_ROOT}/$user"
    local bkp_stage="$snap_home/backup"
    if [ ! -f "$bkp_stage/backup.conf" ]; then
        echo "ERROR: Snapshot '$snapshot' does not contain $HESTIA_HOME_ROOT/$user/backup/backup.conf." >&2
        exit 1
    fi

    local b_date b_time b_mode b_web b_dns b_mail b_db b_cron b_runtime
    b_date="$(extract_kv_from_conf "$bkp_stage/backup.conf" "DATE")"
    b_time="$(extract_kv_from_conf "$bkp_stage/backup.conf" "TIME")"
    b_mode="$(extract_kv_from_conf "$bkp_stage/backup.conf" "BACKUP_MODE")"
    b_web="$(extract_kv_from_conf "$bkp_stage/backup.conf" "WEB")"
    b_dns="$(extract_kv_from_conf "$bkp_stage/backup.conf" "DNS")"
    b_mail="$(extract_kv_from_conf "$bkp_stage/backup.conf" "MAIL")"
    b_db="$(extract_kv_from_conf "$bkp_stage/backup.conf" "DB")"
    b_cron="$(extract_kv_from_conf "$bkp_stage/backup.conf" "CRON")"
    b_runtime="$(extract_kv_from_conf "$bkp_stage/backup.conf" "RUNTIME")"

    [ -z "$b_date" ] && b_date="$(date '+%Y-%m-%d')"
    [ -z "$b_time" ] && b_time="$(date '+%H:%M:%S')"
    [ -z "$b_mode" ] && b_mode="${BACKUP_MODE:-zstd}"
    [ -z "$b_runtime" ] && b_runtime="1"

    local gzip_lvl="${BACKUP_GZIP:-9}"
    [[ "$gzip_lvl" =~ ^[1-9]$ ]] || gzip_lvl=6
    local ext="gz"
    if [ "$b_mode" = "zstd" ]; then
        ext="zst"
        touch "$bkp_stage/.zstd"
    fi

    local ts_slug="${b_date}_${b_time//:/-}"
    local archive_name="${user}.${ts_slug}.tar"
    if [ -z "$output_tar" ]; then
        output_tar="${backup_root%/}/$archive_name"
    else
        archive_name="$(basename "$output_tar")"
    fi

    # 1. Pack web domains into backup/web/<domain>/domain_data.tar.<ext>
    local d_dir domain
    for d_dir in "$bkp_stage/web"/*; do
        [ -d "$d_dir" ] || continue
        domain="$(basename "$d_dir")"
        if [ -d "$snap_home/web/$domain" ]; then
            (
                cd "$snap_home/web/$domain" && \
                tar --exclude='./logs/*' -cpf- -- . | compress_tar_stream "$b_mode" "$gzip_lvl" "$d_dir/domain_data.tar.$ext"
            ) || {
                echo "ERROR: Failed to pack web domain $domain." >&2
                exit 1
            }
        fi
    done

    # 2. Pack mail accounts into backup/mail/<domain>/accounts.tar.<ext>
    for d_dir in "$bkp_stage/mail"/*; do
        [ -d "$d_dir" ] || continue
        domain="$(basename "$d_dir")"
        if [ -d "$snap_home/mail/$domain" ]; then
            local acct_list=()
            local acct_path
            for acct_path in "$snap_home/mail/$domain"/*; do
                [ -e "$acct_path" ] || continue
                acct_list+=("$(basename "$acct_path")")
            done
            if [ "${#acct_list[@]}" -gt 0 ]; then
                (
                    cd "$snap_home/mail/$domain" && \
                    tar -cpf- -- "${acct_list[@]}" | compress_tar_stream "$b_mode" "$gzip_lvl" "$d_dir/accounts.tar.$ext"
                ) || {
                    echo "ERROR: Failed to pack mail accounts for $domain." >&2
                    exit 1
                }
            fi
        fi
    done

    # 3. Pack extra user directories into backup/user_dir/<udir>.tar.<ext>
    mkdir -p "$bkp_stage/user_dir"
    local udir_items=()
    local entry_path udir
    while IFS= read -r entry_path; do
        [ -n "$entry_path" ] || continue
        udir="$(basename "$entry_path")"
        case "$udir" in
            .|..|conf|web|dns|tmp|mail|backup) continue ;;
        esac
        (
            cd "$snap_home" && \
            tar --anchored -cpf- -- "$udir" | compress_tar_stream "$b_mode" "$gzip_lvl" "$bkp_stage/user_dir/$udir.tar.$ext"
        ) || {
            echo "ERROR: Failed to pack user directory $udir." >&2
            exit 1
        }
        udir_items+=("$udir")
    done < <(find "$snap_home" -mindepth 1 -maxdepth 1 | sort)

    local udir_csv=""
    if [ "${#udir_items[@]}" -gt 0 ]; then
        local IFS=','
        udir_csv="${udir_items[*]}"
    fi

    local size_mib
    size_mib="$(du -shm "$bkp_stage" | cut -f 1)"
    [[ "$size_mib" =~ ^[0-9]+$ ]] || size_mib=1

    local bkp_line="BACKUP='$archive_name' TYPE='local' SIZE='$size_mib' WEB='$b_web' DNS='$b_dns' MAIL='$b_mail' DB='$b_db' CRON='$b_cron' UDIR='$udir_csv' RUNTIME='$b_runtime' TIME='$b_time' DATE='$b_date'"
    printf '%s\n' "$bkp_line" > "$bkp_stage/backup.conf"

    mkdir -p "$(dirname "$output_tar")"
    if ! (cd "$bkp_stage" && tar -cf "$output_tar" .); then
        rm -f "$output_tar" 2>/dev/null || true
        echo "ERROR: Failed to build final HestiaCP archive at $output_tar." >&2
        exit 1
    fi
    chmod 0640 "$output_tar" 2>/dev/null || true
    chown root:hestiaweb "$output_tar" 2>/dev/null || true

    # 4. Optionally register in data/users/<user>/backup.conf so it appears in HestiaCP /list/backup/
    local u_dir="$HESTIA/data/users/$user"
    if [ "$REGISTER_EXPORT" = true ] && [ -d "$u_dir" ] && [ "$(cd "$(dirname "$output_tar")" && pwd)" = "${backup_root%/}" ]; then
        touch "$u_dir/backup.conf"
        sed -i "\|BACKUP='$archive_name'|d" "$u_dir/backup.conf" 2>/dev/null || true
        printf '%s\n' "$bkp_line" >> "$u_dir/backup.conf"
        chmod 0660 "$u_dir/backup.conf" 2>/dev/null || true
        if [ -f "$u_dir/user.conf" ]; then
            local new_cnt
            new_cnt="$(grep -c "BACKUP=" "$u_dir/backup.conf" 2>/dev/null || echo 1)"
            sed -i "s/^U_BACKUPS=.*/U_BACKUPS='$new_cnt'/" "$u_dir/user.conf" 2>/dev/null || true
        fi
        echo "[OK] Registered $archive_name in $u_dir/backup.conf (visible in HestiaCP BACKUP tab for instant Download/Restore)."
    fi

    echo "[OK] Exported HestiaCP-compatible archive: $output_tar ($(du -sh "$output_tar" | cut -f1))"
}

case "$ACTION" in
    --init-master-key) do_init_master_key ;;
    --enroll)          do_enroll_all ;;
    --status)          do_status ;;
    --run-daily)       do_run_daily ;;
    --dump-tar)        do_dump_tar ;;
    --export-tar)      do_export_tar ;;
esac
