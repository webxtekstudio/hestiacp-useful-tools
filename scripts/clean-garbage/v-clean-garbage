#!/bin/bash
set -o pipefail

#==========================================
# HESTIACP SYSTEM CLEANUP SCRIPT
# Only cleans system logs and system-level garbage
# Does NOT modify user data, databases, or user files
#==========================================
# CONFIGURATION - Edit these as needed
#==========================================

# Default Configuration (can be overridden by /etc/hestiacp-clean-garbage.conf)

# Email notification (leave empty to auto-detect from admin user)
ADMIN_EMAIL_OVERRIDE=""
# Set to "FALSE" to send email reports ONLY when a cleanup task fails (or with --force-notification)
NOTIFY_ON_SUCCESS="TRUE"

#------------------------------------------
# RETENTION PERIODS (days)
#------------------------------------------
JOURNALCTL_RETENTION_DAYS=7
SERVICE_LOGS_RETENTION_DAYS=30
PHP_SESSIONS_RETENTION_DAYS=1
CORE_DUMPS_RETENTION_DAYS=1
LOCK_FILES_RETENTION_DAYS=1
SSL_TMP_RETENTION_DAYS=7
ORPHAN_BACKUP_TMP_DAYS=2
HST_BACKUPS_KEEP_COUNT=2

#------------------------------------------
# MAIL RETENTION PERIODS
# Options: 1M (1 month), 1Y (1 year), 5Y (5 years)
#------------------------------------------
MAIL_QUEUE_RETENTION="5Y"
SPAM_MAIL_RETENTION="1Y"
USER_TRASH_RETENTION="1Y"

#------------------------------------------
# SYSTEM CLEANUPS (TRUE/FALSE)
#------------------------------------------
CLEAN_JOURNALCTL="TRUE"
CLEAN_APT_CACHE="TRUE"
CLEAN_OLD_KERNELS="TRUE"
CLEAN_PHP_SESSIONS="TRUE"
CLEAN_CORE_DUMPS="TRUE"
CLEAN_LOCK_FILES="TRUE"
CLEAN_SSL_TMP="TRUE"
CLEAN_ORPHAN_BACKUP_TMP="TRUE"
CLEAN_HST_BACKUPS="TRUE"

#------------------------------------------
# SERVICE LOGS CLEANUP (TRUE/FALSE)
#------------------------------------------
CLEAN_NGINX_LOGS="TRUE"
CLEAN_APACHE_LOGS="TRUE"
CLEAN_EXIM_LOGS="TRUE"
CLEAN_DOVECOT_LOGS="TRUE"
CLEAN_CLAMAV_LOGS="TRUE"
CLEAN_ROUNDCUBE_LOGS="TRUE"
CLEAN_FAIL2BAN_LOGS="TRUE"
CLEAN_HESTIA_LOGS="TRUE"
CLEAN_PHP_FPM_LOGS="TRUE"
CLEAN_MYSQL_LOGS="TRUE"
CLEAN_VSFTPD_LOGS="TRUE"
CLEAN_APT_LOGS="TRUE"
CLEAN_CLOUD_INIT_LOGS="TRUE"
CLEAN_UNATTENDED_UPGRADES_LOGS="TRUE"
CLEAN_BTMP_WTMP="TRUE"
CLEAN_ROTATED_LOGS="TRUE"
CLEAN_MYSQL_SLOW_LOGS="TRUE"

#------------------------------------------
# MAIL CLEANUP (TRUE/FALSE)
#------------------------------------------
CLEAN_MAIL_QUEUE="TRUE"
CLEAN_SPAM_MAIL="TRUE"

#------------------------------------------
# USER CLEANUP (TRUE/FALSE)
#------------------------------------------
CLEAN_USER_TRASH="TRUE"
CLEAN_WEB_LOGS="TRUE"

#------------------------------------------
# SSD TRIM (only enable if you have SSD)
#------------------------------------------
RUN_SSD_TRIM="TRUE"

#==========================================
# LOAD EXTERNAL CONFIGURATION
#==========================================
if [ -f "/etc/hestiacp-clean-garbage.conf" ]; then
    source /etc/hestiacp-clean-garbage.conf
fi

FORCE_NOTIFICATION="FALSE"
for arg in "$@"; do
    case "$arg" in
        --force-notification) FORCE_NOTIFICATION="TRUE" ;;
    esac
done
#==========================================

# Single-instance guard using flock (atomic, race-condition free)
LOCK_FILE="/var/run/v-clean-garbage.lock"
exec 9>"$LOCK_FILE"
if ! flock -n 9; then
    echo "[$(date)] : v-clean-garbage is already running. Exiting."
    exit 1
fi

source /etc/profile
HESTIA=/usr/local/hestia
source $HESTIA/func/main.sh 2>/dev/null
source $HESTIA/conf/hestia.conf 2>/dev/null

ADMIN_EMAIL=""
if [ -n "$ADMIN_EMAIL_OVERRIDE" ]; then
    ADMIN_EMAIL="$ADMIN_EMAIL_OVERRIDE"
else
    for user_conf in "$HESTIA/data/users"/*/user.conf; do
        [ -f "$user_conf" ] || continue
        if grep -q "^ROLE='admin'" "$user_conf" 2>/dev/null && ! grep -q "^SUSPENDED='yes'" "$user_conf" 2>/dev/null; then
            ADMIN_EMAIL=$(grep "^CONTACT=" "$user_conf" 2>/dev/null | cut -d"'" -f2)
            [ -n "$ADMIN_EMAIL" ] && break
        fi
    done
    if [ -z "$ADMIN_EMAIL" ]; then
        for user_conf in "$HESTIA/data/users"/*/user.conf; do
            [ -f "$user_conf" ] || continue
            if grep -q "^ROLE='admin'" "$user_conf" 2>/dev/null; then
                ADMIN_EMAIL=$(grep "^CONTACT=" "$user_conf" 2>/dev/null | cut -d"'" -f2)
                [ -n "$ADMIN_EMAIL" ] && break
            fi
        done
    fi
fi

if [ -z "$ADMIN_EMAIL" ]; then
    ADMIN_EMAIL=$(grep "^CONTACT=" "$HESTIA/conf/hestia.conf" 2>/dev/null | cut -d"'" -f2)
fi

# Email notification on unexpected fatal crash (trap)
_send_fatal_email_garbage() {
    local exit_code="$1"
    local line="$2"
    [ -z "$ADMIN_EMAIL" ] && return 0
    local hostname
    hostname=$(hostname -f 2>/dev/null || echo "HestiaCP Server")
    local subject="[FATAL] v-clean-garbage crashed on $hostname"
    local body="Script v-clean-garbage terminated unexpectedly.\nExit code: $exit_code at line $line.\nCheck system logs for details."
    local SENDMAIL="$HESTIA/web/inc/mail-wrapper.php"
    if [ -f "$SENDMAIL" ]; then
        echo "$body" | "$SENDMAIL" -s "$subject" "$ADMIN_EMAIL" 2>/dev/null
    else
        { echo "Subject: $subject"; echo; echo "$body"; } | /usr/sbin/sendmail "$ADMIN_EMAIL" 2>/dev/null
    fi
}
trap '_send_fatal_email_garbage "$?" "$LINENO"' INT TERM ABRT

FINAL_STATUS='SUCCESS'
TASKS_SUCCESS=()
TASKS_FAILED=()
TASKS_SKIPPED=()
TOTAL_CLEANED_KB=0

convert_space() {
    local space_kb=$1
    if [ -z "$space_kb" ] || [ "$space_kb" -eq 0 ] 2>/dev/null; then
        echo "0 MB"
        return
    fi
    
    if command -v bc >/dev/null 2>&1; then
        local space_mb=$(bc <<< "scale=2; $space_kb/1024" 2>/dev/null)
        local space_gb=$(bc <<< "scale=2; $space_mb/1024" 2>/dev/null)

        if (( $(echo "$space_mb < 1024" | bc -l 2>/dev/null) )); then
            printf "%.2f MB" $space_mb
        else
            printf "%.2f GB" $space_gb
        fi
    else
        local space_mb=$((space_kb / 1024))
        if [ "$space_mb" -lt 1024 ]; then
            echo "${space_mb} MB"
        else
            local space_gb=$((space_mb / 1024))
            echo "${space_gb} GB"
        fi
    fi
}

measure_cleanup() {
    local path="$1"
    local size_kb=0
    
    if [ -e "$path" ]; then
        if [ -d "$path" ]; then
            local du_output=$(du -sk "$path" 2>/dev/null | cut -f1)
            if [ -n "$du_output" ] && [ "$du_output" -gt 0 ] 2>/dev/null; then
                size_kb=$du_output
            fi
        elif [ -f "$path" ]; then
            local file_size=$(stat -c%s "$path" 2>/dev/null || echo 0)
            if [ -n "$file_size" ] && [ "$file_size" -gt 0 ] 2>/dev/null; then
                size_kb=$((file_size / 1024))
                [ "$size_kb" -eq 0 ] && [ "$file_size" -gt 0 ] && size_kb=1
            fi
        fi
    fi
    
    echo "$size_kb"
}

add_cleaned_space() {
    local cleaned_kb=$1
    cleaned_kb=${cleaned_kb:-0}
    cleaned_kb=$(echo "$cleaned_kb" | sed 's/[^0-9-]//g')
    if [ -n "$cleaned_kb" ] && [ "$cleaned_kb" != "" ] && [ "$cleaned_kb" -gt 0 ] 2>/dev/null; then
        TOTAL_CLEANED_KB=$((TOTAL_CLEANED_KB + cleaned_kb))
    fi
}

convert_retention_to_days() {
    local retention="$1"
    local days=0
    
    if [ -z "$retention" ]; then
        echo "365"
        return
    fi
    
    retention=$(echo "$retention" | tr '[:lower:]' '[:upper:]')
    
    if echo "$retention" | grep -qE '^[0-9]+[MY]$'; then
        local number=$(echo "$retention" | sed 's/[^0-9]//g')
        local unit=$(echo "$retention" | sed 's/[^MY]//g')
        
        if [ "$unit" = "M" ]; then
            days=$((number * 30))
        elif [ "$unit" = "Y" ]; then
            days=$((number * 365))
        fi
    elif echo "$retention" | grep -qE '^[0-9]+$'; then
        days=$retention
    else
        days=365
    fi
    
    echo "$days"
}

run_task() {
    local task_name="$1"
    local task_command="$2"
    local enabled="$3"
    
    if [ "$enabled" != "TRUE" ] && [ "$enabled" != "true" ]; then
        TASKS_SKIPPED+=("$task_name")
        return 0
    fi
    
    echo -n "[$(date)] : $task_name... "
    if eval "$task_command" >/dev/null 2>&1; then
        echo "OK"
        TASKS_SUCCESS+=("$task_name")
        return 0
    else
        echo "FAIL"
        TASKS_FAILED+=("$task_name")
    FINAL_STATUS='FAILED'
        return 1
    fi
}

clean_rotated_logs() {
    local log_dir="$1"
    local days="$2"
    local cleaned_kb=0
    
    [ -d "$log_dir" ] || { echo "0"; return 0; }
    
    local before_kb=$(measure_cleanup "$log_dir")
    before_kb=${before_kb:-0}
    
    local truncated_size_kb=0
    while IFS= read -r -d '' logfile; do
        if [ -f "$logfile" ]; then
            local log_size=$(stat -c%s "$logfile" 2>/dev/null || echo 0)
            if [ -n "$log_size" ] && [ "$log_size" -gt 104857600 ] 2>/dev/null; then
                if ! lsof "$logfile" >/dev/null 2>&1; then
                    local log_size_kb=$((log_size / 1024))
                    truncated_size_kb=$((truncated_size_kb + log_size_kb))
                fi
            fi
        fi
    done < <(find "$log_dir" -maxdepth 1 -type f -name "*.log" -size +100M -print0 2>/dev/null)
    
    find "$log_dir" -maxdepth 1 -type f \( -name "*.log.[0-9]*" -o -name "*.log.*.gz" -o -name "*.[0-9].gz" \) -mtime +${days} -delete 2>/dev/null
    find "$log_dir" -maxdepth 1 -type f -name "*.log" -size +100M ! -exec lsof {} \; -exec truncate -s 0 {} \; 2>/dev/null
    
    local after_kb=$(measure_cleanup "$log_dir")
    after_kb=${after_kb:-0}
    
    if [ "$before_kb" -gt "$after_kb" ] 2>/dev/null; then
        cleaned_kb=$((before_kb - after_kb))
    fi
    
    if [ "$truncated_size_kb" -gt 0 ] 2>/dev/null; then
        cleaned_kb=$((cleaned_kb + truncated_size_kb))
    fi
    
    echo "${cleaned_kb:-0}"
}

if command -v mariadb >/dev/null 2>&1; then
    DB_CMD="mariadb"
elif command -v mysql >/dev/null 2>&1; then
    DB_CMD="mysql"
else
    DB_CMD=""
fi

initial_space_kb=$(df / | tail -1 | awk '{ print $4 }')
initial_space_formatted=$(convert_space $initial_space_kb)

echo "=========================================="
echo "HestiaCP Garbage Cleanup Started"
log_event "$OK" "System Cleanup Process Started"
echo "Date: $(date)"
echo "Initial Available Space: $initial_space_formatted"
echo "=========================================="
echo ""
echo "--- SYSTEM CLEANUP ---"

if [ "$CLEAN_JOURNALCTL" = "TRUE" ] || [ "$CLEAN_JOURNALCTL" = "true" ]; then
    echo -n "[$(date)] : Journalctl logs (>${JOURNALCTL_RETENTION_DAYS}d)... "
    journalctl_output=$(journalctl --vacuum-time=${JOURNALCTL_RETENTION_DAYS}d 2>&1)
    if [ $? -eq 0 ]; then
        freed_line=$(echo "$journalctl_output" | grep -i "freed" | head -1)
        if [ -n "$freed_line" ]; then
            freed_space=$(echo "$freed_line" | grep -oE '[0-9]+\.?[0-9]*' | head -1)
            freed_unit=$(echo "$freed_line" | grep -oE '[KMGT]?B' | head -1 | tr '[:lower:]' '[:upper:]')
            if [ -n "$freed_space" ] && [ -n "$freed_unit" ]; then
                if [ "$freed_unit" = "MB" ]; then
                    if command -v bc >/dev/null 2>&1; then
                        freed_kb=$(echo "$freed_space * 1024" | bc | cut -d. -f1)
                    else
                        freed_kb=$(awk "BEGIN {printf \"%.0f\", $freed_space * 1024}")
                    fi
                elif [ "$freed_unit" = "GB" ]; then
                    if command -v bc >/dev/null 2>&1; then
                        freed_kb=$(echo "$freed_space * 1024 * 1024" | bc | cut -d. -f1)
                    else
                        freed_kb=$(awk "BEGIN {printf \"%.0f\", $freed_space * 1024 * 1024}")
                    fi
                elif [ "$freed_unit" = "KB" ] || [ "$freed_unit" = "K" ]; then
                    freed_kb=$(echo "$freed_space" | cut -d. -f1)
                else
                    freed_kb=0
                fi
                if [ -n "$freed_kb" ] && [ "$freed_kb" -gt 0 ] 2>/dev/null; then
                    add_cleaned_space "$freed_kb"
                    echo "OK (freed: ${freed_space} ${freed_unit})"
                else
                    echo "OK"
                fi
            else
                echo "OK"
            fi
        else
            echo "OK"
        fi
        TASKS_SUCCESS+=("Journalctl logs")
    else
        echo "FAIL"
        TASKS_FAILED+=("Journalctl logs")
        FINAL_STATUS='FAILED'
    fi
fi

if [ "$CLEAN_APT_CACHE" = "TRUE" ] || [ "$CLEAN_APT_CACHE" = "true" ]; then
    echo -n "[$(date)] : APT cache... "
    apt_cache_dirs="/var/cache/apt/archives /var/cache/apt/archives/partial"
    before_kb=0
    for dir in $apt_cache_dirs; do
        if [ -d "$dir" ]; then
            dir_size=$(du -sk "$dir" 2>/dev/null | cut -f1)
            [ -n "$dir_size" ] && before_kb=$((before_kb + dir_size))
        fi
    done
    if apt-get clean >/dev/null 2>&1; then
        after_kb=0
        for dir in $apt_cache_dirs; do
            if [ -d "$dir" ]; then
                dir_size=$(du -sk "$dir" 2>/dev/null | cut -f1)
                [ -n "$dir_size" ] && after_kb=$((after_kb + dir_size))
            fi
        done
        cleaned_kb=$((before_kb - after_kb))
        if [ "$cleaned_kb" -gt 0 ]; then
            add_cleaned_space "$cleaned_kb"
            cleaned_formatted=$(convert_space $cleaned_kb)
            echo "OK (freed: $cleaned_formatted)"
        else
            echo "OK"
        fi
        TASKS_SUCCESS+=("APT cache")
    else
        echo "FAIL"
        TASKS_FAILED+=("APT cache")
        FINAL_STATUS='FAILED'
    fi
fi

if [ "$CLEAN_OLD_KERNELS" = "TRUE" ] || [ "$CLEAN_OLD_KERNELS" = "true" ]; then
    echo -n "[$(date)] : Old kernel packages... "
    before_kb=$(measure_cleanup /boot)
    kernel_pkgs=$(dpkg -l | grep -E '^ii.*linux-(image|headers)-[0-9]' | awk '{print $2}' | wc -l)
    if DEBIAN_FRONTEND=noninteractive apt-get autoremove -y >/dev/null 2>&1; then
        after_kb=$(measure_cleanup /boot)
        cleaned_kb=$((before_kb - after_kb))
        [ "$cleaned_kb" -lt 0 ] && cleaned_kb=0
        if [ "$cleaned_kb" -gt 0 ] 2>/dev/null; then
            add_cleaned_space "$cleaned_kb"
            cleaned_formatted=$(convert_space $cleaned_kb)
            echo "OK (freed: $cleaned_formatted)"
        else
            echo "OK"
        fi
        TASKS_SUCCESS+=("Old kernel packages")
    else
        echo "FAIL"
        TASKS_FAILED+=("Old kernel packages")
        FINAL_STATUS='FAILED'
    fi
fi

if [ "$CLEAN_PHP_SESSIONS" = "TRUE" ] || [ "$CLEAN_PHP_SESSIONS" = "true" ]; then
    [[ "$PHP_SESSIONS_RETENTION_DAYS" =~ ^[0-9]+$ ]] || PHP_SESSIONS_RETENTION_DAYS=1
    echo -n "[$(date)] : PHP sessions (>${PHP_SESSIONS_RETENTION_DAYS}d)... "
    sess_cleaned_kb=0
    sess_deleted_count=0
    if [ -d "/var/lib/php/sessions" ] && [ ! -L "/var/lib/php/sessions" ]; then
        before_kb=$(measure_cleanup "/var/lib/php/sessions")
        c=$(find /var/lib/php/sessions -maxdepth 1 -type f -mtime +${PHP_SESSIONS_RETENTION_DAYS} -delete 2>/dev/null -print | wc -l)
        after_kb=$(measure_cleanup "/var/lib/php/sessions")
        diff_kb=$((before_kb - after_kb))
        [ "$diff_kb" -gt 0 ] 2>/dev/null && sess_cleaned_kb=$((sess_cleaned_kb + diff_kb))
        sess_deleted_count=$((sess_deleted_count + c))
    fi
    # HestiaCP per-user PHP-FPM pools store session files in /home/<user>/tmp/sess_*
    for u_dir in "$HESTIA/data/users"/*; do
        [ -d "$u_dir" ] || continue
        u_name=$(basename "$u_dir")
        id "$u_name" >/dev/null 2>&1 || continue
        u_home=$(getent passwd "$u_name" | cut -d: -f6)
        [ -n "$u_home" ] && [ ! -L "$u_home" ] && [ -d "$u_home/tmp" ] && [ ! -L "$u_home/tmp" ] || continue
        before_kb=$(measure_cleanup "$u_home/tmp")
        c=$(cd / && runuser -u "$u_name" -- find "$u_home/tmp" -maxdepth 1 -type f -name 'sess_*' -mtime +${PHP_SESSIONS_RETENTION_DAYS} -delete 2>/dev/null -print | wc -l)
        after_kb=$(measure_cleanup "$u_home/tmp")
        diff_kb=$((before_kb - after_kb))
        [ "$diff_kb" -gt 0 ] 2>/dev/null && sess_cleaned_kb=$((sess_cleaned_kb + diff_kb))
        sess_deleted_count=$((sess_deleted_count + c))
    done
    if [ "$sess_cleaned_kb" -gt 0 ]; then
        add_cleaned_space "$sess_cleaned_kb"
        cleaned_formatted=$(convert_space $sess_cleaned_kb)
        echo "OK ($sess_deleted_count files, freed: $cleaned_formatted)"
    else
        echo "OK ($sess_deleted_count files)"
    fi
    TASKS_SUCCESS+=("PHP sessions")
fi

if [ "$CLEAN_SSL_TMP" = "TRUE" ] || [ "$CLEAN_SSL_TMP" = "true" ]; then
    [[ "$SSL_TMP_RETENTION_DAYS" =~ ^[0-9]+$ ]] || SSL_TMP_RETENTION_DAYS=7
    echo -n "[$(date)] : Expired SSL temp dirs (>${SSL_TMP_RETENTION_DAYS}d)... "
    ssl_tmp_count=0
    ssl_tmp_kb=0
    if command -v python3 >/dev/null 2>&1 && [ -d "$HESTIA/data/users" ]; then
        read -r ssl_tmp_count ssl_tmp_kb < <(
            python3 - "$HESTIA/data/users" "$SSL_TMP_RETENTION_DAYS" << 'PYEOF' 2>/dev/null || echo "0 0"
import os
import pwd
import re
import stat
import sys
import time

users_dir = sys.argv[1]
retention_days = int(sys.argv[2])
cutoff_age = retention_days * 86400
now = time.time()
tmp_re = re.compile(r"^tmp\.[A-Za-z0-9]{10}$")
DIR_FLAGS = os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW

deleted_dirs = 0
freed_bytes = 0

try:
    user_names = sorted(os.listdir(users_dir))
except OSError:
    print("0 0")
    sys.exit(0)

for u_name in user_names:
    u_meta = os.path.join(users_dir, u_name)
    if not os.path.isdir(u_meta) or os.path.islink(u_meta):
        continue
    try:
        u_home = pwd.getpwnam(u_name).pw_dir
    except KeyError:
        continue
    if not u_home or not u_home.startswith("/"):
        continue

    try:
        home_fd = os.open(u_home, DIR_FLAGS)
    except OSError:
        continue
    try:
        try:
            web_fd = os.open("web", DIR_FLAGS, dir_fd=home_fd)
        except OSError:
            continue
        try:
            with os.scandir(web_fd) as dom_it:
                for dom_entry in dom_it:
                    if not dom_entry.is_dir(follow_symlinks=False):
                        continue
                    try:
                        dom_fd = os.open(dom_entry.name, DIR_FLAGS, dir_fd=web_fd)
                    except OSError:
                        continue
                    try:
                        try:
                            priv_fd = os.open("private", DIR_FLAGS, dir_fd=dom_fd)
                        except OSError:
                            continue
                        try:
                            with os.scandir(priv_fd) as priv_it:
                                for cand in priv_it:
                                    if not tmp_re.match(cand.name):
                                        continue
                                    try:
                                        cst = cand.stat(follow_symlinks=False)
                                    except OSError:
                                        continue
                                    if not stat.S_ISDIR(cst.st_mode):
                                        continue
                                    # Require root-owned mktemp dir (0700) and both mtime + unforgeable ctime expired
                                    if cst.st_uid != 0 or (cst.st_mode & 0o7777) != 0o700:
                                        continue
                                    if (now - cst.st_mtime) <= cutoff_age or (now - cst.st_ctime) <= cutoff_age:
                                        continue
                                    try:
                                        td_fd = os.open(cand.name, DIR_FLAGS, dir_fd=priv_fd)
                                    except OSError:
                                        continue
                                    try:
                                        fst = os.fstat(td_fd)
                                        if (fst.st_dev, fst.st_ino) != (cst.st_dev, cst.st_ino):
                                            continue
                                        if fst.st_uid != 0 or (fst.st_mode & 0o7777) != 0o700:
                                            continue
                                        children = []
                                        total_sz = 0
                                        safe_flat = True
                                        with os.scandir(td_fd) as td_it:
                                            for ch in td_it:
                                                try:
                                                    chst = ch.stat(follow_symlinks=False)
                                                except OSError:
                                                    safe_flat = False
                                                    break
                                                if not stat.S_ISREG(chst.st_mode) or chst.st_nlink != 1:
                                                    safe_flat = False
                                                    break
                                                total_sz += chst.st_size
                                                children.append(ch.name)
                                                if len(children) > 16 or total_sz > 5 * 1024 * 1024:
                                                    safe_flat = False
                                                    break
                                        if not safe_flat:
                                            continue
                                        ok_unlink = True
                                        for ch_name in children:
                                            try:
                                                os.unlink(ch_name, dir_fd=td_fd)
                                            except OSError:
                                                ok_unlink = False
                                                break
                                        if ok_unlink:
                                            try:
                                                os.rmdir(cand.name, dir_fd=priv_fd)
                                                deleted_dirs += 1
                                                freed_bytes += max(total_sz, 4096)
                                            except OSError:
                                                pass
                                    finally:
                                        os.close(td_fd)
                        finally:
                            os.close(priv_fd)
                    finally:
                        os.close(dom_fd)
        finally:
            os.close(web_fd)
    finally:
        os.close(home_fd)

freed_kb = (freed_bytes + 1023) // 1024 if freed_bytes > 0 else 0
print(f"{deleted_dirs} {freed_kb}")
PYEOF
        )
        ssl_tmp_count=${ssl_tmp_count:-0}
        ssl_tmp_kb=${ssl_tmp_kb:-0}
    fi
    if [ "$ssl_tmp_kb" -gt 0 ]; then
        add_cleaned_space "$ssl_tmp_kb"
        cleaned_formatted=$(convert_space $ssl_tmp_kb)
        echo "OK ($ssl_tmp_count dirs, freed: $cleaned_formatted)"
    else
        echo "OK ($ssl_tmp_count dirs)"
    fi
    TASKS_SUCCESS+=("Expired SSL temp dirs")
fi

if [ "$CLEAN_ORPHAN_BACKUP_TMP" = "TRUE" ] || [ "$CLEAN_ORPHAN_BACKUP_TMP" = "true" ]; then
    [[ "$ORPHAN_BACKUP_TMP_DAYS" =~ ^[0-9]+$ ]] || ORPHAN_BACKUP_TMP_DAYS=2
    echo -n "[$(date)] : Orphaned /backup/tmp.* dirs (>${ORPHAN_BACKUP_TMP_DAYS}d)... "
