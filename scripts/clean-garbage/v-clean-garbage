                trash_cleaned=$((trash_cleaned + 1))
                if [[ "$size_before" =~ ^[0-9]+$ ]] && [[ "$size_after" =~ ^[0-9]+$ ]] && [ "$size_before" -gt "$size_after" ]; then
                    trash_size_kb=$((trash_size_kb + size_before - size_after))
                fi
            fi
        fi
    done
    if [ -d "/root/.local/share/Trash/files" ] && [ ! -L "/root/.local/share/Trash" ] && [ ! -L "/root/.local/share/Trash/files" ]; then
        size_before=$(du -skP "/root/.local/share/Trash" 2>/dev/null | cut -f1)
