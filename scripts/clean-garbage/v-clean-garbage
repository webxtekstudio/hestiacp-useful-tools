            find -P "/root/.local/share/Trash/info" -type f -mtime +"${USER_TRASH_RETENTION_DAYS}" -delete 2>/dev/null || true
        find -P "/root/.local/share/Trash/files" -mindepth 1 -type d -empty -delete 2>/dev/null || true
        size_after=$(du -skP "/root/.local/share/Trash" 2>/dev/null | cut -f1)
        if [[ "$size_before" =~ ^[0-9]+$ ]] && [[ "$size_after" =~ ^[0-9]+$ ]] && [ "$size_before" -gt "$size_after" ]; then
