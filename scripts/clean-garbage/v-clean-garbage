    spam_deleted=0
    for u_dir in "$HESTIA/data/users"/*; do
        [ -d "$u_dir" ] && [ ! -L "$u_dir" ] || continue
        u_name=$(basename "$u_dir")
        [[ "$u_name" =~ ^[a-zA-Z0-9._-]+$ ]] || continue
        id -u "$u_name" >/dev/null 2>&1 || continue
        u_home=$(getent passwd "$u_name" | cut -d: -f6)
        [ -n "$u_home" ] && [ -d "$u_home" ] && [ ! -L "$u_home" ] || continue
        [ -d "$u_home/mail" ] && [ ! -L "$u_home/mail" ] || continue
        mail_owner=$(stat -c '%U' "$u_home/mail" 2>/dev/null || echo "")
        if [ "$mail_owner" != "mail" ] && [ "$mail_owner" != "$u_name" ]; then
            continue
        fi
        c=$(cd / && runuser -u "$mail_owner" -- sh -c '
            home_mail="$1"
            days="$2"
            total=0
            [ -d "$home_mail" ] && [ ! -L "$home_mail" ] || { echo 0; exit 0; }
            for dom_dir in "$home_mail"/*; do
                [ -d "$dom_dir" ] && [ ! -L "$dom_dir" ] || continue
                for mbox_dir in "$dom_dir"/*; do
                    [ -d "$mbox_dir" ] && [ ! -L "$mbox_dir" ] || continue
                    for parent_spam in "$mbox_dir/.Junk" "$mbox_dir/.Spam"; do
                        [ -d "$parent_spam" ] && [ ! -L "$parent_spam" ] || continue
                        for sub in "$parent_spam/cur" "$parent_spam/new"; do
                            [ -d "$sub" ] && [ ! -L "$sub" ] || continue
                            n=$(find -P "$sub" -type f -mtime +"$days" -delete -print 2>/dev/null | wc -l)
                            total=$((total + n))
                        done
                    done
                done
            done
            echo "$total"
        ' _ "$u_home/mail" "$SPAM_MAIL_RETENTION_DAYS" 2>/dev/null || echo "0")
        [[ "$c" =~ ^[0-9]+$ ]] && spam_deleted=$((spam_deleted + c))
