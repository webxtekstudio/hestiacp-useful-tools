    for u_dir in "$HESTIA/data/users"/*; do
        [ -d "$u_dir" ] && [ ! -L "$u_dir" ] || continue
        u_name=$(basename "$u_dir")
        [[ "$u_name" =~ ^[a-zA-Z0-9._-]+$ ]] || continue
        id -u "$u_name" >/dev/null 2>&1 || continue
        u_home=$(getent passwd "$u_name" | cut -d: -f6)
        [ -n "$u_home" ] && [ -d "$u_home" ] && [ ! -L "$u_home" ] || continue
        res=$(cd / && runuser -u "$u_name" -- sh -c '
            tdir="$1/.local/share/Trash"
            days="$2"
            [ ! -L "$1/.local" ] && [ ! -L "$1/.local/share" ] && [ -d "$tdir" ] && [ ! -L "$tdir" ] || exit 0
            [ -d "$tdir/files" ] && [ ! -L "$tdir/files" ] || exit 0
            sb=$(du -skP "$tdir" 2>/dev/null | cut -f1)
            find -P "$tdir/files" -type f -mtime +"$days" -delete 2>/dev/null || true
            if [ -d "$tdir/info" ] && [ ! -L "$tdir/info" ]; then
                find -P "$tdir/info" -type f -mtime +"$days" -delete 2>/dev/null || true
            fi
            find -P "$tdir/files" -mindepth 1 -type d -empty -delete 2>/dev/null || true
            sa=$(du -skP "$tdir" 2>/dev/null | cut -f1)
            echo "1 ${sb:-0} ${sa:-0}"
        ' _ "$u_home" "$USER_TRASH_RETENTION_DAYS" 2>/dev/null || true)
        if [ -n "$res" ]; then
            read -r did_clean size_before size_after <<< "$res"
