    keep_hst=${HST_BACKUPS_KEEP_COUNT:-2}
    echo -n "[$(date)] : HestiaCP upgrade snapshots (keep latest ${keep_hst})... "
    hst_del_count=0
    hst_del_kb=0
    if [ -d "/root/hst_backups" ] && [ ! -L "/root/hst_backups" ] && [[ "$keep_hst" =~ ^[0-9]+$ ]]; then
        # HestiaCP names /root/hst_backups snapshots DDMMYYYYHHMM ($(date +%d%m%Y%H%M)).
        # Normalize DDMMYYYYHHMM -> YYYYMMDDHHMM before descending sort so newest snapshots are kept.
        mapfile -t hst_dirs < <(
            for d in /root/hst_backups/[0-9]*; do
                [ -d "$d" ] && [ ! -L "$d" ] || continue
                bn=$(basename "$d")
                if [[ "$bn" =~ ^(0[1-9]|[12][0-9]|3[01])(0[1-9]|1[0-2])(20[0-9]{2})([0-9]{4})$ ]]; then
                    skey="${BASH_REMATCH[3]}${BASH_REMATCH[2]}${BASH_REMATCH[1]}${BASH_REMATCH[4]}"
                elif [[ "$bn" =~ ^(20[0-9]{2})(0[1-9]|1[0-2])(0[1-9]|[12][0-9]|3[01])([0-9]{4,6})$ ]]; then
                    skey="$bn"
                else
                    skey=$(date -d "@$(stat -c '%Y' "$d" 2>/dev/null || echo 0)" +%Y%m%d%H%M 2>/dev/null || echo "000000000000")
                fi
                printf '%s|%s\n' "$skey" "$d"
            done | sort -t'|' -k1,1r | cut -d'|' -f2-
        )
        if [ "${#hst_dirs[@]}" -gt "$keep_hst" ]; then
            for (( i=keep_hst; i<${#hst_dirs[@]}; i++ )); do
                old_hst="${hst_dirs[$i]}"
                [ -d "$old_hst" ] && [ ! -L "$old_hst" ] || continue
                td_kb=$(measure_cleanup "$old_hst")
                if rm -rf "$old_hst" 2>/dev/null; then
                    hst_del_count=$((hst_del_count + 1))
                    hst_del_kb=$((hst_del_kb + td_kb))
                fi
            done
        fi
    fi
    if [ "$hst_del_kb" -gt 0 ]; then
        add_cleaned_space "$hst_del_kb"
        cleaned_formatted=$(convert_space $hst_del_kb)
        echo "OK ($hst_del_count removed, freed: $cleaned_formatted)"
    else
