# Configuration for v-add-exim-limit
# Place this file at /etc/hestiacp-exim-limit.conf

#==========================================
# LIMIT SETTINGS
#==========================================
# Maximum message size in Megabytes
MAX_MESSAGE_SIZE_MB=25

# Limit Scope:
# TRUE  = Limit ONLY outgoing emails (authenticated users). Recommended to prevent IP bans.
# FALSE = Limit BOTH incoming and outgoing emails. Saves disk space but may reject client emails.
LIMIT_OUTGOING_ONLY="TRUE"

#==========================================
# ANTI-SPOOFING SETTINGS
#==========================================
# Block unauthenticated external senders forging any local HestiaCP domain (+local_domains)
# in the visual From: header ($h_from:) when bypassing envelope MAIL FROM checks
# (for example, using an empty Return-Path: <> bounce sender or multi-address From: header).
# Note: To allow legitimate third-party relays (SendGrid, SES, Mailgun) to deliver mail using
# a local From: domain to local mailboxes, add their IPs/CIDRs to /etc/exim4/white-blocks.conf.
BLOCK_HEADER_FROM_SPOOF="TRUE"

# Notification email settings used by monitor_large_emails.py.
# Leave empty to auto-detect the Hestia admin contact and server hostname.
ADMIN_EMAIL=""
SENDER_EMAIL=""
